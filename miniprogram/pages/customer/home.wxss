.page {
	min-height: 100vh;
	background: #f5f7f8;
	padding: 28rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));
	box-sizing: border-box;
}

.header {
	background: linear-gradient(135deg, #3B82E6 0%, #5A9CF0 100%);
	border-radius: 24rpx;
	color: #fff;
	padding: 36rpx 34rpx;
	margin-bottom: 28rpx;
}

.title {
	font-size: 40rpx;
	font-weight: bold;
}

.desc {
	font-size: 25rpx;
	opacity: .92;
	margin-top: 14rpx;
	line-height: 1.6;
}

.stats {
	display: flex;
	margin-top: 28rpx;
}

.stat {
	flex: 1;
	text-align: center;
}

.stat-num {
	font-size: 40rpx;
	font-weight: bold;
}

.stat-label {
	font-size: 24rpx;
	opacity: .9;
	margin-top: 6rpx;
}

.card {
	background: #fff;
	border-radius: 24rpx;
	padding: 30rpx;
	margin-bottom: 28rpx;
	box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .06);
}

.card-title {
	font-size: 30rpx;
	font-weight: 600;
	color: #333;
	margin-bottom: 24rpx;
}

.plates-input {
	width: 100%;
	min-height: 160rpx;
	background: #f7f9fa;
	border-radius: 16rpx;
	padding: 20rpx;
	box-sizing: border-box;
	font-size: 28rpx;
	margin-bottom: 24rpx;
}

.primary-btn {
	width: 100%;
	height: 88rpx;
	line-height: 88rpx;
	background: linear-gradient(135deg, #3B82E6 0%, #5A9CF0 100%);
	color: #fff;
	font-size: 32rpx;
	font-weight: 600;
	border-radius: 44rpx;
	border: none;
}

.tips {
	margin-top: 18rpx;
	font-size: 24rpx;
	color: #999;
	line-height: 1.6;
}

.empty {
	text-align: center;
	color: #aaa;
	font-size: 26rpx;
	padding: 24rpx 0;
}

.plate-item {
	display: flex;
	align-items: center;
	justify-content: space-between;
	padding: 22rpx 0;
	border-bottom: 1rpx solid #f0f0f0;
}

.plate-item:last-child {
	border-bottom: none;
}

.plate-left {
	flex: 1;
}

.plate-no {
	font-size: 32rpx;
	font-weight: 600;
	color: #222;
	letter-spacing: 2rpx;
}

.plate-no.dim {
	color: #999;
}

.plate-meta {
	font-size: 23rpx;
	color: #999;
	margin-top: 8rpx;
}

.plate-right {
	display: flex;
	align-items: center;
}

.plate-status {
	font-size: 23rpx;
	padding: 6rpx 18rpx;
	border-radius: 999rpx;
	margin-left: 16rpx;
}

.plate-status.on {
	background: #e3f2fd;
	color: #1565C0;
}

.plate-status.using {
	background: #fff4e5;
	color: #e67e22;
}

.plate-status.off {
	background: #f0f0f0;
	color: #999;
}

.plate-del {
	font-size: 24rpx;
	color: #E64340;
	padding: 6rpx 8rpx 6rpx 24rpx;
}

.exit-btn {
	margin-top: 20rpx;
	width: 100%;
	height: 88rpx;
	line-height: 88rpx;
	background: #fff;
	color: #E64340;
	font-size: 30rpx;
	border-radius: 44rpx;
	border: 2rpx solid #f0c0bd;
}

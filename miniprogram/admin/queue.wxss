.page {
	min-height: 100vh;
	background: #f5f7f8;
	padding: 28rpx;
	box-sizing: border-box;
}

.header {
	background: #3B82E6;
	border-radius: 24rpx;
	color: #fff;
	padding: 36rpx 30rpx;
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 28rpx;
}

.title {
	font-size: 40rpx;
	font-weight: bold;
}

.desc {
	font-size: 26rpx;
	opacity: .86;
	margin-top: 14rpx;
}

.header-actions {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.driver-mgr {
	font-size: 24rpx;
	background: rgba(255, 255, 255, .16);
	padding: 10rpx 20rpx;
	border-radius: 999rpx;
	text-align: center;
}

.logout {
	font-size: 24rpx;
	background: rgba(255, 255, 255, .16);
	padding: 10rpx 20rpx;
	border-radius: 999rpx;
	text-align: center;
}

.toolbar {
	display: flex;
	gap: 20rpx;
	margin-bottom: 24rpx;
}

.picker {
	flex: 1;
	height: 84rpx;
	line-height: 84rpx;
	background: #fff;
	border-radius: 16rpx;
	padding: 0 24rpx;
	color: #000;
	font-size: 28rpx;
	box-sizing: border-box;
}

.call-btn {
	width: 190rpx;
	height: 84rpx;
	line-height: 84rpx;
	border-radius: 42rpx;
	background: #f07818;
	color: #fff;
	font-size: 30rpx;
}

.summary {
	font-size: 26rpx;
	color: #7b8794;
	margin-bottom: 18rpx;
}

.queue-card {
	background: #fff;
	border-radius: 20rpx;
	padding: 28rpx;
	margin-bottom: 22rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
	border-left: 8rpx solid #3B82E6;
}

.queue-card:active {
	opacity: .82;
}

.queue-card.called {
	border-left-color: #f07818;
}

.queue-card.booked {
	border-left-color: #7b8794;
}

.top {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.no {
	font-size: 48rpx;
	font-weight: bold;
	color: #000;
}

.status {
	font-size: 24rpx;
	color: #000;
	background: #eef0ff;
	padding: 8rpx 20rpx;
	border-radius: 999rpx;
}

.called .status {
	color: #f07818;
	background: #fff1e6;
}

.booked .status {
	color: #627d98;
	background: #f0f4f8;
}

.plate {
	font-size: 36rpx;
	font-weight: bold;
	color: #000;
	margin: 18rpx 0 10rpx;
}

.meta {
	font-size: 26rpx;
	color: #627d98;
	line-height: 1.7;
}

.finish-btn {
	margin-top: 22rpx;
	height: 76rpx;
	line-height: 76rpx;
	border-radius: 38rpx;
	background: #3B82E6;
	color: #fff;
	font-size: 28rpx;
}

.empty {
	background: #fff;
	border-radius: 20rpx;
	padding: 70rpx 30rpx;
	text-align: center;
	color: #8a99a8;
	font-size: 28rpx;
}

.refresh {
	text-align: center;
	color: #000;
	font-size: 26rpx;
	padding: 34rpx 0;
}

.detail-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(15, 23, 42, .46);
	z-index: 99;
	display: flex;
	align-items: flex-end;
}

.detail-panel {
	width: 100%;
	max-height: 86vh;
	overflow-y: auto;
	background: #fff;
	border-radius: 30rpx 30rpx 0 0;
	padding: 34rpx 30rpx 44rpx;
	box-sizing: border-box;
}

.detail-head {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 26rpx;
}

.detail-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #000;
}

.detail-sub {
	margin-top: 8rpx;
	font-size: 24rpx;
	color: #7b8794;
}

.detail-close {
	font-size: 26rpx;
	color: #000;
	padding: 8rpx 0 8rpx 24rpx;
}

.detail-grid {
	background: #f7fafc;
	border-radius: 18rpx;
	padding: 10rpx 22rpx;
}

.detail-row {
	display: flex;
	justify-content: space-between;
	gap: 24rpx;
	padding: 20rpx 0;
	border-bottom: 1rpx solid #e8edf2;
	font-size: 26rpx;
}

.detail-row:last-child {
	border-bottom: none;
}

.detail-label {
	color: #7b8794;
	flex-shrink: 0;
}

.detail-value {
	color: #000;
	text-align: right;
	word-break: break-all;
}

.detail-link {
	color: #000;
}

.detail-actions {
	display: flex;
	margin-top: 26rpx;
}

.detail-actions.two {
	gap: 18rpx;
}

.detail-btn {
	flex: 1;
	height: 78rpx;
	line-height: 78rpx;
	border-radius: 39rpx;
	text-align: center;
	font-size: 28rpx;
}

.detail-btn.primary {
	background: #3B82E6;
	color: #fff;
}

.detail-btn.ghost {
	background: #f0f4f8;
	color: #000;
}

.edit-form {
	background: #f7fafc;
	border-radius: 18rpx;
	padding: 24rpx;
}

.form-group {
	margin-bottom: 22rpx;
}

.form-label {
	font-size: 25rpx;
	color: #627d98;
	margin-bottom: 12rpx;
}

.edit-input {
	height: 78rpx;
	line-height: 78rpx;
	background: #fff;
	border: 1rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 0 20rpx;
	box-sizing: border-box;
	font-size: 28rpx;
	color: #000;
}

.cancel-box {
	margin-top: 30rpx;
	padding-top: 26rpx;
	border-top: 1rpx solid #e8edf2;
}

.reason-input {
	width: 100%;
	height: 150rpx;
	background: #f7fafc;
	border: 1rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 18rpx 20rpx;
	box-sizing: border-box;
	font-size: 26rpx;
	color: #000;
}

.danger-btn {
	margin-top: 20rpx;
	height: 78rpx;
	line-height: 78rpx;
	border-radius: 39rpx;
	background: #e53e3e;
	color: #fff;
	font-size: 28rpx;
	text-align: center;
}

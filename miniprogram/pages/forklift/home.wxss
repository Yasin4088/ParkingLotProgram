.page {
	min-height: 100vh;
	background: #f5f5f5;
	padding-bottom: 40rpx;
}

.custom-nav {
	background: #3B82E6;
	color: #fff;
	box-sizing: border-box;
	position: relative;
}

.custom-nav-back {
	position: absolute;
	left: 32rpx;
	width: 64rpx;
	display: flex;
	align-items: center;
	justify-content: flex-start;
}

.custom-nav-back-icon {
	width: 22rpx;
	height: 22rpx;
	border-left: 4rpx solid #fff;
	border-bottom: 4rpx solid #fff;
	transform: rotate(45deg);
}

.custom-nav-title {
	text-align: center;
	font-size: 32rpx;
	font-weight: 600;
}

.header {
	background: #3B82E6;
	color: #fff;
	padding: 36rpx 30rpx;
	position: relative;
}

.header .desc {
	font-size: 30rpx;
	opacity: 0.95;
	line-height: 1.5;
}

.task-card {
	background: #fff;
	margin: 30rpx 20rpx;
	border-radius: 16rpx;
	padding: 30rpx 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.task-status {
	display: inline-block;
	font-size: 24rpx;
	background: #eef5ff;
	color: #3B82E6;
	padding: 6rpx 20rpx;
	border-radius: 20rpx;
	margin-bottom: 20rpx;
}

.task-grid {
	margin-bottom: 24rpx;
}

.task-row {
	display: flex;
	justify-content: space-between;
	padding: 14rpx 0;
	border-bottom: 2rpx solid #f5f5f5;
}

.t-label {
	font-size: 28rpx;
	color: #999;
}

.t-value {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
}

.complete-btn {
	width: 100%;
	height: 88rpx;
	background: linear-gradient(135deg, #3B82E6 0%, #5A9CF0 100%);
	color: #fff;
	font-size: 34rpx;
	font-weight: bold;
	border-radius: 44rpx;
	border: none;
	line-height: 88rpx;
}

.finish-proof {
	margin: 24rpx 0;
	padding: 24rpx;
	border-radius: 16rpx;
	background: #f7fafc;
}

.finish-title {
	font-size: 28rpx;
	color: #102a43;
	font-weight: 600;
}

.finish-desc {
	margin-top: 8rpx;
	font-size: 24rpx;
	color: #7b8794;
	line-height: 1.5;
}

.upload {
	width: 240rpx;
	height: 170rpx;
	margin-top: 18rpx;
	border-radius: 16rpx;
	background: #fff;
	border: 2rpx dashed #cfd8d4;
	overflow: hidden;
}

.upload image {
	width: 100%;
	height: 100%;
}

.upload-empty {
	height: 170rpx;
	line-height: 170rpx;
	text-align: center;
	color: #789;
	font-size: 26rpx;
}

.empty-card {
	margin: 60rpx 40rpx;
	text-align: center;
}

.empty-title {
	font-size: 32rpx;
	color: #999;
	margin-bottom: 12rpx;
}

.empty-desc {
	font-size: 26rpx;
	color: #bbb;
}

.refresh {
	text-align: center;
	font-size: 28rpx;
	color: #333;
	padding: 30rpx;
}

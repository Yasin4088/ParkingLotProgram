<view class="page">
	<view class="header">
		<view>
			<view class="title">管理员</view>
			<view class="desc">查看排队列表，叫号并指派叉车司机</view>
		</view>
		<view class="header-actions">
			<view class="driver-mgr" bindtap="bindAdminHomeTap">后台管理</view>
		</view>
	</view>

	<view class="summary">当前队列 {{list.length}} 辆</view>

	<view wx:if="{{list.length}}">
		<view wx:for="{{list}}" wx:key="_id" data-id="{{item._id}}" bindtap="bindItemTap" class="queue-card {{item.QUEUE_STATUS === 2 ? 'called' : ''}} {{item.QUEUE_STATUS === 3 ? 'confirmed' : ''}} {{item.QUEUE_STATUS === 0 ? 'booked' : ''}}">
			<view class="top">
				<view class="no">{{item.QUEUE_NO || '未签到'}}</view>
				<view class="status {{item.QUEUE_STATUS === 2 ? 'sts-called' : ''}} {{item.QUEUE_STATUS === 3 ? 'sts-confirmed' : ''}}">{{item.statusDesc}}</view>
			</view>
			<view class="plate">{{item.QUEUE_PLATE}}</view>
			<view class="meta">{{item.QUEUE_ACTION_NAME}} · {{item.QUEUE_PHONE}}</view>
			<view wx:if="{{item.QUEUE_CARGO_NAME}}" class="meta">货物：{{item.QUEUE_CARGO_NAME}}</view>
			<view wx:if="{{item.checkinTimeText}}" class="meta">签到：{{item.checkinTimeText}}</view>
			<view wx:else class="meta">预约：{{item.addTimeText || '--'}}</view>

			<!-- 多叉车司机标签 -->
			<view wx:if="{{item.forkliftTotalCount}}" class="forklift-tags">
				<view class="fl-tags-header">
					<text>叉车 ({{item.forkliftAcceptedCount}}/{{item.forkliftTotalCount}} 已接)</text>
					<text wx:if="{{item.QUEUE_STATUS === 2}}" class="fl-view-detail" data-id="{{item._id}}" catchtap="bindViewAssignments">详情</text>
				</view>
				<view class="fl-tags-row">
					<view wx:for="{{item.forkliftAssignments}}" wx:key="id" wx:for-item="fl" class="fl-tag {{fl.status === 1 ? 'accepted' : fl.status === 2 ? 'rejected' : fl.status === 9 ? 'timeout' : 'pending'}}">
						{{fl.name}}
					</view>
					<view wx:if="{{!item.forkliftAssignments || !item.forkliftAssignments.length}}">
						<view wx:if="{{item.QUEUE_FORKLIFT_NAME}}" class="fl-tag accepted">{{item.QUEUE_FORKLIFT_NAME}}</view>
					</view>
				</view>
			</view>

			<!-- 叫号时间 -->
			<view wx:if="{{item.callTimeText}}" class="meta">叫号：{{item.callTimeText}}</view>

			<!-- 排队中 → 叫号按钮 -->
			<button wx:if="{{item.QUEUE_STATUS === 1}}" class="call-btn" data-id="{{item._id}}" catchtap="bindCallTap">指定叫号</button>

			<!-- 已叫号 → 进度提示 -->
			<view wx:if="{{item.QUEUE_STATUS === 2}}" class="wait-confirm">
				司机{{item.driverConfirmed ? '已确认' : '未确认'}} · 叉车{{item.forkliftAcceptedCount}}/{{item.forkliftTotalCount}}已接
			</view>

			<!-- 已确认 → 完成按钮 -->
			<button wx:if="{{item.QUEUE_STATUS === 3}}" class="finish-btn" data-id="{{item._id}}" catchtap="bindFinishTap">完成装卸</button>
		</view>
	</view>

	<view wx:else class="empty">暂无预约或排队车辆</view>

	<view class="refresh" bindtap="bindRefreshTap">刷新列表</view>

	<!-- 叫号弹窗（多选） -->
	<view wx:if="{{showCallModal}}" class="call-mask" bindtap="bindCloseCallModal">
		<view class="call-panel" catchtap="bindNoop">
			<view class="call-head">
				<view class="call-title">指定叫号确认</view>
				<view class="call-close" bindtap="bindCloseCallModal">取消</view>
			</view>

			<view class="call-info">
				<view class="call-row">
					<text class="call-label">车牌号</text>
					<text class="call-value">{{callTarget.QUEUE_PLATE}}</text>
				</view>
				<view class="call-row">
					<text class="call-label">业务类型</text>
					<text class="call-value">{{callTarget.QUEUE_ACTION_NAME}}</text>
				</view>
				<view wx:if="{{callTarget.QUEUE_CARGO_NAME}}" class="call-row">
					<text class="call-label">货物名称</text>
					<text class="call-value">{{callTarget.QUEUE_CARGO_NAME}}</text>
				</view>
				<view class="call-row">
					<text class="call-label">排队号</text>
					<text class="call-value">{{callTarget.QUEUE_NO}}</text>
				</view>
			</view>

			<view class="call-forklift">
				<view class="call-label">指派叉车司机（可多选，已选 {{selectedForkliftIds.length}} 人）</view>
				<scroll-view scroll-y class="forklift-check-list">
					<view wx:for="{{forkliftList}}" wx:key="_id" class="forklift-check-row" data-index="{{index}}" bindtap="bindToggleForklift">
						<view class="check-box {{item.checked ? 'checked' : ''}}">
							<text wx:if="{{item.checked}}">✓</text>
						</view>
						<text class="check-name">{{item.USER_NAME}}</text>
					</view>
				</scroll-view>
			</view>

			<button class="call-confirm-btn" loading="{{callLoading}}" bindtap="bindConfirmCall">确认指定叫号</button>
		</view>
	</view>

	<!-- 接单状态弹窗 -->
	<view wx:if="{{showAssignModal}}" class="call-mask" bindtap="bindCloseAssignModal">
		<view class="call-panel" catchtap="bindNoop">
			<view class="call-head">
				<view class="call-title">叉车司机响应状态</view>
				<view class="call-close" bindtap="bindCloseAssignModal">关闭</view>
			</view>

			<view wx:if="{{assignmentTarget.forkliftAssignments && assignmentTarget.forkliftAssignments.length}}" class="assign-list">
				<view wx:for="{{assignmentTarget.forkliftAssignments}}" wx:key="id" class="assign-row">
					<view class="assign-info">
						<text class="assign-name">{{item.name}}</text>
						<text class="assign-status {{item.status === 1 ? 'ok' : item.status === 0 ? 'wait' : 'fail'}}">
							{{item.status === 0 ? '待响应' : item.status === 1 ? '已接受' : item.status === 2 ? '已拒绝' : item.status === 9 ? '超时' : ''}}
						</text>
					</view>
					<view wx:if="{{item.status === 2 || item.status === 9}}" class="reassign-btn" data-forkliftid="{{item.id}}" catchtap="bindReassignTap">重新分配</view>
				</view>
			</view>
			<view wx:else class="assign-empty">暂无叉车分配信息</view>

			<!-- 司机确认状态 -->
			<view class="assign-driver-status">
				<text>司机确认：</text>
				<text class="{{assignmentTarget.driverConfirmed ? 'ok' : 'wait'}}">{{assignmentTarget.driverConfirmed ? '已确认' : '未确认'}}</text>
			</view>
		</view>
	</view>

	<!-- 重新分派弹窗 -->
	<view wx:if="{{showReassignModal}}" class="call-mask" bindtap="bindCloseReassignModal">
		<view class="call-panel small" catchtap="bindNoop">
			<view class="call-head">
				<view class="call-title">重新分派叉车司机</view>
				<view class="call-close" bindtap="bindCloseReassignModal">取消</view>
			</view>
			<view class="call-forklift">
				<view class="call-label">选择新叉车司机</view>
				<picker mode="selector" range="{{reassignForkliftList}}" range-key="USER_NAME" value="{{reassignIndex}}" bindchange="bindReassignChange">
					<view class="forklift-picker">{{reassignForkliftList[reassignIndex].USER_NAME}}</view>
				</picker>
			</view>
			<button class="call-confirm-btn" loading="{{reassignLoading}}" bindtap="bindConfirmReassign">确认调整</button>
		</view>
	</view>

	<!-- 详情弹窗 -->
	<view wx:if="{{showDetail}}" class="detail-mask" bindtap="bindCloseDetailTap">
		<view class="detail-panel" catchtap="bindNoop">
			<view class="detail-head">
				<view>
					<view class="detail-title">{{editMode ? '编辑预约' : '预约详情'}}</view>
					<view class="detail-sub">{{selectedItem.QUEUE_NO || '未签到'}} · {{selectedItem.statusDesc}}</view>
				</view>
				<view class="detail-close" bindtap="bindCloseDetailTap">关闭</view>
			</view>

			<view wx:if="{{!editMode}}">
				<view class="detail-grid">
					<view class="detail-row">
						<view class="detail-label">车牌号</view>
						<view class="detail-value">{{selectedItem.QUEUE_PLATE || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">手机号</view>
						<view class="detail-value">{{selectedItem.QUEUE_PHONE || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">业务类型</view>
						<view class="detail-value">{{selectedItem.QUEUE_ACTION_NAME || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">货物名称</view>
						<view class="detail-value">{{selectedItem.QUEUE_CARGO_NAME || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">叉车司机</view>
						<view class="detail-value">{{selectedItem.forkliftSummary || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">预约时间</view>
						<view class="detail-value">{{selectedItem.addTimeText || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">签到时间</view>
						<view class="detail-value">{{selectedItem.checkinTimeText || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">叫号时间</view>
						<view class="detail-value">{{selectedItem.callTimeText || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">确认时间</view>
						<view class="detail-value">{{selectedItem.confirmTimeText || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">完成时间</view>
						<view class="detail-value">{{selectedItem.finishTimeText || '--'}}</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">装卸凭证</view>
						<view wx:if="{{selectedItem.QUEUE_PROOF}}" class="detail-link" bindtap="bindPreviewProofTap">点击查看</view>
						<view wx:else class="detail-value">--</view>
					</view>
					<view class="detail-row">
						<view class="detail-label">完成凭证</view>
						<view wx:if="{{selectedItem.QUEUE_FINISH_PROOF}}" class="detail-link" bindtap="bindPreviewFinishProofTap">点击查看</view>
						<view wx:else class="detail-value">--</view>
					</view>
				</view>

				<view class="detail-actions">
					<view class="detail-btn primary" bindtap="bindEditTap">编辑成员</view>
				</view>
			</view>

			<view wx:else class="edit-form">
				<view class="form-group">
					<view class="form-label">车牌号</view>
					<input class="edit-input" value="{{editForm.plate}}" bindinput="bindPlateInput" maxlength="20" placeholder="请输入车牌号" />
				</view>
				<view class="form-group">
					<view class="form-label">手机号</view>
					<input class="edit-input" value="{{editForm.phone}}" bindinput="bindPhoneInput" type="number" maxlength="11" placeholder="请输入手机号" />
				</view>
				<view class="form-group">
					<view class="form-label">业务类型</view>
					<picker mode="selector" range="{{actions}}" range-key="name" value="{{actionEditIndex}}" bindchange="bindEditActionChange">
						<view class="edit-input">{{actions[actionEditIndex].name}}</view>
					</picker>
				</view>
				<view class="form-group">
					<view class="form-label">货物名称</view>
					<input class="edit-input" value="{{editForm.cargoName}}" bindinput="bindCargoNameInput" maxlength="50" placeholder="请输入货物名称" />
				</view>

				<view class="detail-actions two">
					<view class="detail-btn ghost" bindtap="bindCancelEditTap">取消编辑</view>
					<view class="detail-btn primary" bindtap="bindSaveEditTap">{{submitting ? '保存中...' : '保存修改'}}</view>
				</view>
			</view>

			<view class="cancel-box">
				<view class="form-label">删除/取消原因</view>
				<textarea class="reason-input" value="{{cancelReason}}" bindinput="bindCancelReasonInput" maxlength="80" placeholder="请输入原因，将用于通知司机重新预约" />
				<view class="danger-btn" bindtap="bindCancelQueueTap">{{submitting ? '处理中...' : '删除并取消预约'}}</view>
			</view>
		</view>
	</view>
</view>

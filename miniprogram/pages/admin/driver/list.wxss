.page {
    min-height: 100vh;
    background: #f5f5f5;
    padding-bottom: 40rpx;
}

.header {
    background: #009F72;
    color: #fff;
    padding: 30rpx 30rpx 24rpx;
    position: relative;
}

.header .title {
    font-size: 36rpx;
    font-weight: bold;
}

.header .desc {
    font-size: 24rpx;
    margin-top: 8rpx;
    opacity: 0.85;
}

.header .back {
    position: absolute;
    right: 30rpx;
    top: 50%;
    transform: translateY(-50%);
    font-size: 26rpx;
    padding: 10rpx 20rpx;
    border: 2rpx solid rgba(255,255,255,0.6);
    border-radius: 8rpx;
}

/* 添加表单 */
.add-card {
    background: #fff;
    margin: 20rpx;
    border-radius: 16rpx;
    padding: 30rpx 24rpx 20rpx;
}

.card-title {
    font-size: 30rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 20rpx;
    padding-bottom: 16rpx;
    border-bottom: 2rpx solid #f0f0f0;
}

.form-row {
    height: 80rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 10rpx;
    margin-bottom: 16rpx;
    display: flex;
    align-items: center;
    padding: 0 20rpx;
}

.form-row input {
    width: 100%;
    font-size: 28rpx;
    color: #333;
}

.add-btn {
    width: 100%;
    height: 80rpx;
    background: #009F72;
    color: #fff;
    font-size: 30rpx;
    border-radius: 40rpx;
    border: none;
    line-height: 80rpx;
    margin-top: 10rpx;
}

/* 司机列表项 */
.driver-item {
    background: #fff;
    margin: 16rpx 20rpx;
    border-radius: 12rpx;
    padding: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10rpx;
}

.d-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.d-status {
    font-size: 22rpx;
    padding: 4rpx 16rpx;
    border-radius: 20rpx;
}

.d-status.on {
    background: #e8f5e9;
    color: #2e7d32;
}

.d-status.off {
    background: #fbe9e7;
    color: #c62828;
}

.mid-row {
    font-size: 24rpx;
    color: #888;
    margin-bottom: 14rpx;
}

.split {
    margin: 0 12rpx;
    color: #ddd;
}

.bottom-row {
    display: flex;
    justify-content: flex-end;
    border-top: 2rpx solid #f5f5f5;
    padding-top: 16rpx;
}

.del-btn {
    font-size: 26rpx;
    color: #e57373;
    padding: 8rpx 24rpx;
}

.load {
    text-align: center;
    font-size: 26rpx;
    padding: 20rpx;
}

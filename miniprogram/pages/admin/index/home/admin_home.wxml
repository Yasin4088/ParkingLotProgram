<view wx:if="{{!isLoad}}" class="margin-top load loading text-l text-admin"></view>

<view class="main-admin" wx:if="{{isLoad && isAdmin}}">

	<view class="admin-info bg-admin">
		<view class="pic"><text class="icon-peoplefill"></text></view>
		<view class="right">
			<view class="name">
				<text class="text-xl">{{admin.name}}</text>

				<text wx:if="{{admin.type==1}}" class="tag small bg-orange light radius margin-left-s">超级管理员</text>
				<text wx:if="{{admin.type==0}}" class="tag small bg-green radius margin-left-s">一般管理员</text>

			</view>
		</view>
	</view>

	<!-- 实时队列统计（点击回看板） -->
	<view class="comm-list grid col-4">
		<view class="item" bindtap="bindStatsTap">
			<view class="stat-num">{{stats.total}}</view>
			<text class="stat-label">在单</text>
		</view>
		<view class="item" bindtap="bindStatsTap">
			<view class="stat-num">{{stats.waiting}}</view>
			<text class="stat-label">排队中</text>
		</view>
		<view class="item" bindtap="bindStatsTap">
			<view class="stat-num">{{stats.executing}}</view>
			<text class="stat-label">执行中</text>
		</view>
		<view class="item" bindtap="bindStatsTap">
			<view class="stat-num">{{stats.topay}}</view>
			<text class="stat-label">待支付</text>
		</view>
	</view>

	<view class="bar bg-white solid-bottom margin-top-s ">
		<view class="action">
			<text class="icon-title"></text>功能管理
		</view>
	</view>

	<view class="comm-list grid col-4">
		<view class="item" bindtap="url" data-url="../../driver/list"> <text class="icon-peoplefill text-orange"></text> <text class="text-black">司机管理</text></view>
		<view class="item" bindtap="url" data-url="../../forklift/list"> <text class="icon-peoplefill text-orange"></text> <text class="text-black">叉车/吊柜司机管理</text></view>
		<view class="item" bindtap="url" data-url="../../queue_history"> <text class="icon-footprint text-blue"></text> <text class="text-black">历史记录</text></view>
		<view wx:if="{{admin.type==1}}" class="item" bindtap="url" data-url="../../mgr/admin/list"> <text class="icon-peoplefill text-blue"></text> <text class="text-black">管理员管理</text></view>
	</view>

	<!-- BOTTOM begin -->
	<view class="comm-list menu  margin-top">
		<view class="item arrow" bindtap="bindSettingTap">
			<view class="content">
				<text class="icon-settings text-grey"></text>
				<text class="text-black">设置</text>
			</view>
		</view>
	</view>

	<!-- BOTTOM END -->
	<button bindtap="bindExitTap" class="btn-admin">退出登录</button>

	<!-- 底部工作区切换：装卸货 / 存取柜 / 后台 -->
	<view class="bottom-nav">
		<view class="bottom-nav-item" bindtap="bindNavQueueTap">装卸货</view>
		<view class="bottom-nav-item" bindtap="bindNavStorageTap">存取柜</view>
		<view class="bottom-nav-item active" bindtap="bindNavAdminTap">后台</view>
	</view>

</view>

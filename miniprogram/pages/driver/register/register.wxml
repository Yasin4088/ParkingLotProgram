<view class="container">
  <!-- 顶部说明 -->
  <view class="reg-card">
    <view class="reg-title">{{mode === 'edit' ? '个人信息' : '完善司机信息'}}</view>
    <view class="reg-subtitle">{{mode === 'edit' ? '查看和修改您的注册信息' : '首次使用需完成实名认证'}}</view>
  </view>

  <!-- 手机号获取 -->
  <view class="reg-card">
    <view class="section-title">手机号 <text style="color:red;">*</text></view>
    <block wx:if="{{!phoneGot}}">
      <button class="phone-btn" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber">
        微信授权获取手机号
      </button>
      <view class="divider-text">—— 或手动输入 ——</view>
      <view class="input-group">
        <input class="input-field" type="number" placeholder="请输入手机号（仅开发测试用）" value="{{manualPhone}}" bindinput="onInput" data-field="manualPhone" maxlength="11" />
      </view>
      <button class="manual-btn" bindtap="onManualPhoneConfirm">使用手动输入的手机号</button>
    </block>
    <block wx:else>
      <view class="phone-got">
        <view class="phone-check">✓ 已获取手机号</view>
        <view class="phone-num">{{phone}}</view>
      </view>
    </block>
  </view>

  <!-- 基本信息 -->
  <view class="reg-card">
    <view class="section-title">基本信息</view>

    <view class="input-group">
      <view class="input-label">姓名 <text style="color:red;">*</text></view>
      <input class="input-field" placeholder="请输入真实姓名" value="{{name}}" bindinput="onInput" data-field="name" />
    </view>

    <view class="input-group">
      <view class="input-label">身份证号 <text style="color:red;">*</text></view>
      <input class="input-field" type="idcard" placeholder="请输入18位身份证号" value="{{idCard}}" bindinput="onInput" data-field="idCard" maxlength="18" />
    </view>

    <view class="input-group">
      <view class="input-label">车牌号 <text style="color:red;">*</text></view>
      <input class="input-field" placeholder="请输入车牌号（如粤B12345）" value="{{licensePlate}}" bindinput="onInput" data-field="licensePlate" maxlength="10" />
    </view>
  </view>

  <!-- 证件上传 -->
  <view class="reg-card">
    <view class="section-title">证件照片 <text style="color:red;">*</text>（三证齐全）</view>

    <!-- 驾驶证 -->
    <view class="upload-group">
      <view class="input-label">驾驶证照片</view>
      <view class="upload-zone" wx:if="{{!driverLicenseImg}}" bindtap="uploadImage" data-field="driverLicenseImg">
        <block wx:if="{{uploadingDriverLicense}}">
          <view class="upload-text">上传中...</view>
        </block>
        <block wx:else>
          <view class="upload-icon">📷</view>
          <view class="upload-text">点击上传驾驶证</view>
        </block>
      </view>
      <view wx:else class="upload-preview" bindtap="uploadImage" data-field="driverLicenseImg">
        <image src="{{driverLicenseLocal || driverLicenseImg}}" mode="aspectFill" class="preview-img" />
        <view class="preview-tip">点击重新上传</view>
      </view>
    </view>

    <!-- 行驶证 -->
    <view class="upload-group">
      <view class="input-label">行驶证照片</view>
      <view class="upload-zone" wx:if="{{!vehicleRegImg}}" bindtap="uploadImage" data-field="vehicleRegImg">
        <block wx:if="{{uploadingVehicleReg}}">
          <view class="upload-text">上传中...</view>
        </block>
        <block wx:else>
          <view class="upload-icon">📷</view>
          <view class="upload-text">点击上传行驶证</view>
        </block>
      </view>
      <view wx:else class="upload-preview" bindtap="uploadImage" data-field="vehicleRegImg">
        <image src="{{vehicleRegLocal || vehicleRegImg}}" mode="aspectFill" class="preview-img" />
        <view class="preview-tip">点击重新上传</view>
      </view>
    </view>

    <!-- 身份证 -->
    <view class="upload-group">
      <view class="input-label">身份证照片</view>
      <view class="upload-zone" wx:if="{{!idCardImg}}" bindtap="uploadImage" data-field="idCardImg">
        <block wx:if="{{uploadingIdCard}}">
          <view class="upload-text">上传中...</view>
        </block>
        <block wx:else>
          <view class="upload-icon">📷</view>
          <view class="upload-text">点击上传身份证</view>
        </block>
      </view>
      <view wx:else class="upload-preview" bindtap="uploadImage" data-field="idCardImg">
        <image src="{{idCardLocal || idCardImg}}" mode="aspectFill" class="preview-img" />
        <view class="preview-tip">点击重新上传</view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submitRegister">
    {{mode === 'edit' ? '保存修改' : '提交注册'}}
  </button>

  <!-- 底部说明 -->
  <view class="footer-text">信息仅用于停车场管理，不会外泄</view>
</view>

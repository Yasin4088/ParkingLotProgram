.page {
	min-height: 100vh;
	background: #f5f5f5;
	padding: 30rpx 20rpx;
}

.form-card {
	background: #fff;
	border-radius: 16rpx;
	padding: 30rpx 24rpx;
}

.section-title {
	font-size: 30rpx;
	color: #3B82E6;
	font-weight: bold;
	padding: 24rpx 0 16rpx 0;
	margin-top: 16rpx;
	border-top: 2rpx solid #f0f0f0;
}

.section-title:first-child {
	border-top: none;
	margin-top: 0;
	padding-top: 0;
}

.form-group {
	margin-bottom: 24rpx;
	display: flex;
	align-items: center;
}

.form-group .label {
	width: 150rpx;
	flex-shrink: 0;
	font-size: 28rpx;
	color: #333;
	font-weight: bold;
	margin-bottom: 0;
}

.form-group input {
	width: auto;
	flex: 1;
	min-width: 0;
	height: 88rpx;
	border: 2rpx solid #e0e0e0;
	border-radius: 12rpx;
	padding: 0 20rpx;
	font-size: 28rpx;
	color: #333;
	box-sizing: border-box;
}

.form-group picker {
	flex: 1;
	min-width: 0;
}

.ph {
	color: #bbb;
}

.form-hint {
	font-size: 22rpx;
	color: #999;
	line-height: 1.6;
	margin: -10rpx 0 24rpx 150rpx;
}

.picker-val {
	width: auto;
	height: 88rpx;
	border: 2rpx solid #e0e0e0;
	border-radius: 12rpx;
	padding: 0 20rpx;
	font-size: 28rpx;
	color: #333;
	line-height: 88rpx;
	box-sizing: border-box;
}

.readonly-val {
	width: auto;
	flex: 1;
	min-width: 0;
	min-height: 88rpx;
	border: 2rpx solid #f0f0f0;
	border-radius: 12rpx;
	padding: 0 20rpx;
	font-size: 28rpx;
	color: #666;
	line-height: 88rpx;
	box-sizing: border-box;
	background: #fafafa;
}

.submit-btn {
	width: 100%;
	height: 88rpx;
	background: #3B82E6;
	color: #fff;
	font-size: 32rpx;
	border-radius: 44rpx;
	line-height: 88rpx;
	text-align: center;
	margin-top: 40rpx;
}

.clear-btn {
	width: 100%;
	height: 88rpx;
	background: #fff;
	color: #E64340;
	font-size: 28rpx;
	border: 2rpx solid #E64340;
	border-radius: 44rpx;
	line-height: 88rpx;
	text-align: center;
	margin-top: 24rpx;
	box-sizing: border-box;
}

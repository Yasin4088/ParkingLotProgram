<view class="page">
	<view class="custom-nav" style="height: {{customBar}}px; padding-top: {{statusBar}}px;">
		<view class="custom-nav-title" style="height: {{navBarHeight}}px; line-height: {{navBarHeight}}px;">司机预约</view>
	</view>

	<view class="header">
		<view class="title">司机预约</view>
		<view class="desc">选择停车场、装卸类型，填写信息后进入排队流程</view>
	</view>

	<view class="card">
		<view class="form-item">
			<view class="label">停车场</view>
			<picker mode="selector" range="{{lots}}" range-key="name" value="{{lotIndex}}" bindchange="bindLotChange">
				<view class="picker">{{lots.length ? lots[lotIndex].name : '请选择停车场'}}</view>
			</picker>
		</view>

		<view class="form-item">
			<view class="label">业务类型</view>
			<picker mode="selector" range="{{actions}}" range-key="name" value="{{actionIndex}}" bindchange="bindActionChange">
				<view class="picker">{{actions.length ? actions[actionIndex].name : '请选择装货/卸货'}}</view>
			</picker>
		</view>

		<view class="form-item">
			<view class="label">车牌号</view>
			<input value="{{plate}}" placeholder="例如：粤B12345" maxlength="20" bindinput="bindPlateInput" />
		</view>

		<view class="form-item">
			<view class="label">手机号</view>
			<input value="{{phone}}" placeholder="用于现场联系" type="number" maxlength="11" bindinput="bindPhoneInput" />
		</view>

		<view class="form-item">
			<view class="label">货物名称</view>
			<input value="{{cargoName}}" placeholder="请输入货物名称（选填）" maxlength="50" bindinput="bindCargoNameInput" />
		</view>

		<view class="form-item">
			<view class="label">单证照片（可选）</view>
			<view class="upload" bindtap="bindChooseProof">
				<image wx:if="{{proofLocal}}" src="{{proofLocal}}" mode="aspectFill"></image>
				<view wx:else class="upload-empty">拍照/上传单证（选填）</view>
			</view>
		</view>

		<button class="primary-btn" loading="{{submitting}}" bindtap="bindSubmitTap">提交预约</button>
	</view>

	<view class="footer-actions">
		<view bindtap="bindQueueTap">查看我的排队</view>
		<view bindtap="bindProfileTap">个人信息</view>
		<view bindtap="bindLogoutTap">退出登录</view>
	</view>
</view>

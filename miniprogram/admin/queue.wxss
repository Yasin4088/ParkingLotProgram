.page {
	min-height: 100vh;
	background: #f5f7f8;
	padding: 28rpx;
	box-sizing: border-box;
}

.header {
	background: #3B82E6;
	border-radius: 24rpx;
	color: #fff;
	padding: 36rpx 30rpx;
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 28rpx;
}

.title {
	font-size: 40rpx;
	font-weight: bold;
}

.desc {
	font-size: 26rpx;
	opacity: .86;
	margin-top: 24rpx;
	line-height: 1.5;
}

.header-actions {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
	align-self: stretch;
	align-items: center;
	justify-content: center;
	flex-shrink: 0;
}

.create-task,
.driver-mgr {
	min-width: 148rpx;
	height: 72rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 26rpx;
	background: rgba(255, 255, 255, .24);
	padding: 0 28rpx;
	border-radius: 999rpx;
	text-align: center;
	box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, .18), 0 6rpx 16rpx rgba(0, 0, 0, .08);
}

.create-task {
	background: #fff;
	color: #3B82E6;
	font-weight: bold;
}

.summary {
	font-size: 26rpx;
	color: #7b8794;
	margin-bottom: 18rpx;
}

/* 状态统计筛选条 */
.chip-bar {
	display: flex;
	flex-wrap: wrap;
	gap: 14rpx;
	margin-bottom: 18rpx;
}

.chip {
	font-size: 24rpx;
	color: #627d98;
	background: #fff;
	padding: 10rpx 22rpx;
	border-radius: 999rpx;
	border: 1rpx solid #d9e2ec;
}

.chip.active {
	color: #fff;
	background: #3B82E6;
	border-color: #3B82E6;
	font-weight: bold;
}

/* 当前环节用时 */
.elapsed {
	font-size: 24rpx;
	color: #9fb3c8;
	margin-top: 8rpx;
}

.queue-card {
	background: #fff;
	border-radius: 20rpx;
	padding: 28rpx;
	margin-bottom: 22rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
	border-left: 8rpx solid #3B82E6;
}

.queue-card:active {
	opacity: .82;
}

/* 状态配色（卡片左边条 + 徽标） */
.queue-card.st-pending {
	border-left-color: #7b8794;
}

.queue-card.st-booked {
	border-left-color: #627d98;
}

.queue-card.st-waiting {
	border-left-color: #3B82E6;
}

.queue-card.st-called {
	border-left-color: #f07818;
}

.queue-card.st-executing {
	border-left-color: #2196F3;
}

.queue-card.st-settling {
	border-left-color: #7c3aed;
}

.queue-card.st-topay {
	border-left-color: #e53e3e;
}

.top {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.no {
	font-size: 48rpx;
	font-weight: bold;
	color: #000;
}

.status {
	font-size: 24rpx;
	color: #000;
	background: #eef0ff;
	padding: 8rpx 20rpx;
	border-radius: 999rpx;
}

.status.st-pending {
	color: #627d98;
	background: #f0f4f8;
}

.status.st-booked {
	color: #486581;
	background: #eef2f6;
}

.status.st-waiting {
	color: #1565C0;
	background: #e3f2fd;
}

.status.st-called {
	color: #f07818;
	background: #fff1e6;
}

.status.st-executing {
	color: #1565C0;
	background: #e3f2fd;
}

.status.st-settling {
	color: #7c3aed;
	background: #f3e8ff;
}

.status.st-topay {
	color: #c62828;
	background: #ffebee;
}

.plate {
	font-size: 36rpx;
	font-weight: bold;
	color: #000;
	margin: 18rpx 0 10rpx;
}

.meta {
	font-size: 26rpx;
	color: #627d98;
	line-height: 1.7;
}

/* 卡片内操作按钮 */
.card-actions {
	margin-top: 20rpx;
	display: flex;
	gap: 16rpx;
}

.card-btn {
	flex: 1;
	height: 68rpx;
	line-height: 68rpx;
	border-radius: 34rpx;
	text-align: center;
	font-size: 26rpx;
	box-sizing: border-box;
}

.card-btn.orange {
	background: #fff1e6;
	color: #f07818;
	border: 1rpx solid #f07818;
}

.card-btn.ghost {
	background: #f0f4f8;
	color: #627d98;
	border: 1rpx solid #d9e2ec;
}

/* 状态提示条 */
.wait-confirm {
	margin-top: 16rpx;
	font-size: 26rpx;
	color: #f07818;
	background: #fff1e6;
	padding: 12rpx 20rpx;
	border-radius: 12rpx;
	text-align: center;
}

.wait-confirm.blue {
	color: #1565C0;
	background: #e3f2fd;
}

.wait-confirm.red {
	color: #c62828;
	background: #ffebee;
}

.wait-confirm.gray {
	color: #627d98;
	background: #f0f4f8;
}

.call-btn {
	margin-top: 22rpx;
	height: 76rpx;
	line-height: 76rpx;
	border-radius: 38rpx;
	background: #f07818;
	color: #fff;
	font-size: 28rpx;
}

.finish-btn {
	margin-top: 22rpx;
	height: 76rpx;
	line-height: 76rpx;
	border-radius: 38rpx;
	background: #3B82E6;
	color: #fff;
	font-size: 28rpx;
}

.empty {
	background: #fff;
	border-radius: 20rpx;
	padding: 70rpx 30rpx;
	text-align: center;
	color: #8a99a8;
	font-size: 28rpx;
}

.refresh {
	text-align: center;
	color: #000;
	font-size: 26rpx;
	padding: 34rpx 0;
}

/* ========== 弹窗通用 ========== */

.call-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(15, 23, 42, .46);
	z-index: 100;
	display: flex;
	align-items: center;
	justify-content: center;
}

.call-panel {
	width: 620rpx;
	background: #fff;
	border-radius: 24rpx;
	padding: 40rpx 34rpx 34rpx;
	box-sizing: border-box;
}

.call-panel.small {
	padding: 34rpx 30rpx 28rpx;
}

.call-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 24rpx;
}

.call-title {
	font-size: 34rpx;
	font-weight: bold;
	color: #102a43;
}

.call-close {
	font-size: 28rpx;
	color: #999;
	padding: 8rpx;
}

.call-info {
	background: #f7fafc;
	border-radius: 14rpx;
	padding: 16rpx 20rpx;
	margin-bottom: 24rpx;
}

.call-row {
	display: flex;
	justify-content: space-between;
	padding: 12rpx 0;
	border-bottom: 1rpx solid #e8edf2;
	font-size: 28rpx;
}

.call-row:last-child {
	border-bottom: none;
}

.call-label {
	color: #7b8794;
}

.call-value {
	color: #243b53;
	font-weight: 500;
}

.call-tip {
	font-size: 25rpx;
	color: #627d98;
	background: #f7fafc;
	border-radius: 12rpx;
	padding: 16rpx 20rpx;
	margin-bottom: 26rpx;
	line-height: 1.6;
}

.call-forklift {
	margin-bottom: 30rpx;
}

.call-forklift .call-label {
	font-size: 28rpx;
	color: #333;
	font-weight: bold;
	margin-bottom: 14rpx;
	display: block;
}

.forklift-picker {
	width: 100%;
	height: 84rpx;
	line-height: 84rpx;
	background: #f7fafc;
	border: 2rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 0 22rpx;
	font-size: 30rpx;
	color: #E67E22;
	font-weight: bold;
	box-sizing: border-box;
	text-align: center;
}

.call-confirm-btn {
	width: 100%;
	height: 84rpx;
	line-height: 84rpx;
	border-radius: 42rpx;
	background: #f07818;
	color: #fff;
	font-size: 32rpx;
}

/* ========== 表单（弹窗内） ========== */

.form-group {
	margin-bottom: 22rpx;
}

.form-label {
	font-size: 25rpx;
	color: #627d98;
	margin-bottom: 12rpx;
}

.edit-input {
	height: 78rpx;
	line-height: 78rpx;
	background: #fff;
	border: 1rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 0 20rpx;
	box-sizing: border-box;
	font-size: 28rpx;
	color: #000;
}

/* 费用动态行 */
.fee-row {
	display: flex;
	align-items: center;
	gap: 14rpx;
	margin-bottom: 14rpx;
}

.fee-input {
	height: 76rpx;
	line-height: 76rpx;
	background: #fff;
	border: 1rpx solid #d9e2ec;
	border-radius: 12rpx;
	padding: 0 18rpx;
	box-sizing: border-box;
	font-size: 28rpx;
	color: #000;
}

.fee-input.name {
	flex: 1.6;
}

.fee-input.amount {
	flex: 1;
}

/* 固定费用项名称标签（与输入行对齐） */
.fee-label-fixed {
	flex: 1.6;
	height: 76rpx;
	line-height: 76rpx;
	font-size: 28rpx;
	color: #243b53;
	font-weight: 500;
	flex-shrink: 0;
}

/* 备注输入框 */
.remark-input {
	height: 160rpx;
	width: 100%;
	padding: 16rpx 20rpx;
	font-size: 28rpx;
	color: #000;
	box-sizing: border-box;
}

/* 看板卡片备注（2 行截断） */
.remark-clamp {
	font-size: 24rpx;
	color: #627d98;
	margin-top: 8rpx;
	line-height: 1.5;
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	overflow: hidden;
	word-break: break-all;
}

/* 详情备注（保留换行） */
.remark-text {
	white-space: pre-wrap;
	word-break: break-all;
}

.fee-remove {
	width: 60rpx;
	height: 76rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	color: #c62828;
	font-size: 30rpx;
	flex-shrink: 0;
}

.fee-add {
	font-size: 26rpx;
	color: #3B82E6;
	padding: 8rpx 0 26rpx;
}

/* ========== 详情弹窗 ========== */

.detail-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(15, 23, 42, .46);
	z-index: 99;
	display: flex;
	align-items: flex-end;
}

.detail-panel {
	width: 100%;
	max-height: 86vh;
	overflow-y: auto;
	background: #fff;
	border-radius: 30rpx 30rpx 0 0;
	padding: 34rpx 30rpx 44rpx;
	box-sizing: border-box;
}

.detail-head {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 26rpx;
}

.detail-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #000;
}

.detail-sub {
	margin-top: 8rpx;
	font-size: 24rpx;
	color: #7b8794;
}

.detail-close {
	font-size: 26rpx;
	color: #000;
	padding: 8rpx 0 8rpx 24rpx;
}

.detail-grid {
	background: #f7fafc;
	border-radius: 18rpx;
	padding: 10rpx 22rpx;
}

.detail-row {
	display: flex;
	justify-content: space-between;
	gap: 24rpx;
	padding: 20rpx 0;
	border-bottom: 1rpx solid #e8edf2;
	font-size: 26rpx;
}

.detail-row:last-child {
	border-bottom: none;
}

.detail-label {
	color: #7b8794;
	flex-shrink: 0;
}

.detail-value {
	color: #000;
	text-align: right;
	word-break: break-all;
}

.detail-link {
	color: #000;
}

.detail-actions {
	display: flex;
	margin-top: 26rpx;
}

.detail-actions.two {
	gap: 18rpx;
}

.detail-btn {
	flex: 1;
	height: 78rpx;
	line-height: 78rpx;
	border-radius: 39rpx;
	text-align: center;
	font-size: 28rpx;
}

.detail-btn.primary {
	background: #3B82E6;
	color: #fff;
}

.detail-btn.warn {
	background: #f07818;
	color: #fff;
}

.detail-btn.ghost {
	background: #f0f4f8;
	color: #000;
}

/* 费用明细 */
.fee-box {
	margin-top: 24rpx;
	background: #f7fafc;
	border-radius: 18rpx;
	padding: 20rpx 22rpx;
}

.fee-box-title {
	font-size: 26rpx;
	color: #627d98;
	margin-bottom: 8rpx;
}

.fee-line {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 12rpx 0;
	border-bottom: 1rpx solid #e8edf2;
}

.fee-line:last-child {
	border-bottom: none;
}

.fee-line-name {
	font-size: 27rpx;
	color: #000;
	display: flex;
	align-items: center;
	gap: 10rpx;
}

.fee-line-type {
	font-size: 20rpx;
	color: #7b8794;
	background: #e8edf2;
	padding: 2rpx 10rpx;
	border-radius: 6rpx;
}

.fee-line-amount {
	font-size: 27rpx;
	color: #000;
	font-weight: 500;
}

.fee-empty {
	font-size: 26rpx;
	color: #999;
	padding: 16rpx 0;
}

.fee-total {
	margin-top: 14rpx;
	text-align: right;
	font-size: 30rpx;
	font-weight: bold;
	color: #e53e3e;
}

.pay-box {
	margin-top: 24rpx;
	background: #fff1e6;
	border-radius: 14rpx;
	padding: 16rpx 22rpx;
	font-size: 26rpx;
	color: #f07818;
}

.edit-form {
	background: #f7fafc;
	border-radius: 18rpx;
	padding: 24rpx;
}

.edit-tip {
	background: #fff1e6;
	color: #f07818;
	font-size: 24rpx;
	border-radius: 10rpx;
	padding: 12rpx 16rpx;
	margin-bottom: 18rpx;
}

.cancel-box {
	margin-top: 30rpx;
	padding-top: 26rpx;
	border-top: 1rpx solid #e8edf2;
}

.reason-input {
	width: 100%;
	height: 150rpx;
	background: #f7fafc;
	border: 1rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 18rpx 20rpx;
	box-sizing: border-box;
	font-size: 26rpx;
	color: #000;
}

.danger-btn {
	margin-top: 20rpx;
	height: 78rpx;
	line-height: 78rpx;
	border-radius: 39rpx;
	background: #e53e3e;
	color: #fff;
	font-size: 28rpx;
	text-align: center;
}

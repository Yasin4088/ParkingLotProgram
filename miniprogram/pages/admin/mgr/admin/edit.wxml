<view wx:if="{{isAdmin && isLoad}}" class="page">
    <view class="form-card">
        <view class="form-group">
            <view class="label">管理员名</view>
            <input placeholder="请输入管理员名" placeholder-class="ph" value="{{name}}" bindinput="bindNameInput" maxlength="20" />
        </view>

        <view class="form-group">
            <view class="label">密码{{id ? '（留空则不修改）' : ''}}</view>
            <input placeholder="{{id ? '留空则不修改密码' : '请输入密码'}}" placeholder-class="ph" type="text" value="{{password}}" bindinput="bindPasswordInput" maxlength="20" />
        </view>

        <view class="form-group">
            <view class="label">手机号</view>
            <input placeholder="请输入手机号（选填）" placeholder-class="ph" type="number" value="{{phone}}" bindinput="bindPhoneInput" maxlength="11" />
        </view>

        <view class="form-group">
            <view class="label">管理员类型</view>
            <picker mode="selector" range="{{typeItems}}" range-key="label" value="{{typeIndex}}" bindchange="bindTypeChange">
                <view class="picker-val">{{typeItems[typeIndex].label}}</view>
            </picker>
        </view>

        <view class="form-group">
            <view class="label">状态</view>
            <picker mode="selector" range="{{statusItems}}" range-key="label" value="{{statusIndex}}" bindchange="bindStatusChange">
                <view class="picker-val">{{statusItems[statusIndex].label}}</view>
            </picker>
        </view>

        <view class="submit-btn" bindtap="bindSubmitTap">
            <view wx:if="{{submitting}}">提交中...</view>
            <view wx:else>{{id ? '保存修改' : '确认添加'}}</view>
        </view>
    </view>
</view>
.page {
    min-height: 100vh;
    background: #f5f5f5;
    padding: 30rpx 20rpx;
}

.form-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 30rpx 24rpx;
}

.form-group {
    margin-bottom: 24rpx;
}

.form-group .label {
    font-size: 28rpx;
    color: #333;
    font-weight: bold;
    margin-bottom: 12rpx;
}

.form-group input {
    width: 100%;
    height: 88rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 12rpx;
    padding: 0 20rpx;
    font-size: 28rpx;
    color: #333;
    box-sizing: border-box;
}

.ph {
    color: #bbb;
}

.picker-val {
    width: 100%;
    height: 88rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 12rpx;
    padding: 0 20rpx;
    font-size: 28rpx;
    color: #333;
    box-sizing: border-box;
    line-height: 88rpx;
}

.submit-btn {
    width: 100%;
    height: 88rpx;
    background: #009F72;
    color: #fff;
    font-size: 32rpx;
    border-radius: 44rpx;
    line-height: 88rpx;
    text-align: center;
    margin-top: 40rpx;
}
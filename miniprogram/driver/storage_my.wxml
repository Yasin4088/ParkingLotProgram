<view class="page">
	<view class="custom-nav" style="height: {{customBar}}px; padding-top: {{statusBar}}px;">
		<view class="custom-nav-back" style="top: {{statusBar}}px; height: {{navBarHeight}}px;" bindtap="bindBackTap">
			<view class="custom-nav-back-icon"></view>
		</view>
		<view class="custom-nav-title" style="height: {{navBarHeight}}px; line-height: {{navBarHeight}}px;">我的存柜</view>
	</view>

	<view class="header">
		<view class="title">我的存柜</view>
		<view class="desc">存柜码请妥善保存，取柜时凭码登记并按天缴费</view>
	</view>

	<view wx:for="{{list}}" wx:key="_id" class="card">
		<view class="status {{item.STORAGE_STATUS === 1 || item.STORAGE_STATUS === 6 ? 'called' : ''}} {{item.STORAGE_STATUS === 4 ? 'topay' : ''}}">{{item.statusDesc}}</view>

		<view class="code-row" bindtap="bindCopyCode" data-code="{{item.STORAGE_CODE}}">
			<view class="code">{{item.STORAGE_CODE}}</view>
			<view class="code-copy">复制存柜码</view>
		</view>
		<view class="code-label">存柜码</view>

		<view class="info-grid">
			<view>
				<view class="info-label">业务</view>
				<view class="info-val">{{item.typeName}}</view>
			</view>
			<view>
				<view class="info-label">车牌</view>
				<view class="info-val">{{item.STORAGE_PLATE}}</view>
			</view>
			<view>
				<view class="info-label">柜型 / 柜号</view>
				<view class="info-val">{{item.STORAGE_CABINET_NAME}} · {{item.STORAGE_CABINET_NO}}</view>
			</view>
			<view wx:if="{{item.STORAGE_STATUS === 0 || item.STORAGE_STATUS === 5}}">
				<view class="info-label">排队号 / 前方</view>
				<view class="info-val strong">{{item.STORAGE_NO}} · {{item.ahead || 0}}人</view>
			</view>
			<view wx:else>
				<view class="info-label">排队号</view>
				<view class="info-val">{{item.STORAGE_NO || '--'}}</view>
			</view>
		</view>

		<!-- 取柜单费用 -->
		<view wx:if="{{item.STORAGE_STATUS >= 4}}" class="fee-box">
			<view class="fee-box-title">取柜费用</view>
			<block wx:if="{{item.noCharge}}">
				<view class="fee-line">
					<view class="fee-line-name">其他公司单</view>
					<view class="fee-line-amount">不计费</view>
				</view>
				<view class="fee-total">无需付款</view>
			</block>
			<block wx:else>
				<view class="fee-line">
					<view class="fee-line-name">{{item.STORAGE_DAYS}} 天 × ¥{{item.priceDailyText}}/天</view>
					<view class="fee-line-amount">¥{{item.feeTotalText}}</view>
				</view>
				<view class="fee-line">
					<view class="fee-line-name">支付状态</view>
					<view class="fee-line-amount">{{item.payStatusDesc}}</view>
				</view>
				<view class="fee-total">合计：¥{{item.feeTotalText}}</view>
			</block>
		</view>

		<!-- 状态提示 -->
		<view wx:if="{{item.STORAGE_STATUS === 0}}" class="tips">已登记，等待管理员叫号后吊柜司机开始存柜。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 1}}" class="tips">已叫号，等待吊柜司机接单。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 2}}" class="tips">吊柜司机正在存柜作业，请留意现场安排。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 3}}" class="tips">已存柜，取柜请凭存柜码登记{{item.noCharge ? '（其他公司单不计费）' : '并按天缴费'}}。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 4 && item.payMode === 1}}" class="tips">费用已锁定，请完成支付后进入取柜排队。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 4}}" class="tips">费用已锁定，请到现场缴费，管理员确认收款后进入排队。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 5 && item.noCharge}}" class="tips">其他公司单，不计费，已进入取柜排队。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 5 && item.STORAGE_MONTHLY === 1}}" class="tips">月付单已进入取柜排队，无需现场缴费（费用记公司月结）。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 5}}" class="tips">已缴费，等待管理员叫号。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 6}}" class="tips">已叫号，等待吊柜司机接单。</view>
		<view wx:elif="{{item.STORAGE_STATUS === 7}}" class="tips">吊柜司机正在取柜作业，请留意现场安排。</view>

		<button wx:if="{{item.STORAGE_STATUS === 4 && item.payMode === 1 && wxpayEnable}}" loading="{{paying}}" class="pay-btn" bindtap="bindPayTap" data-id="{{item._id}}">去支付 ¥{{item.feeTotalText}}</button>
	</view>

	<!-- 无进行中记录：最近一条历史记录（只读） -->
	<view wx:if="{{!list.length && lastDone}}" class="empty-card">
		<view class="empty-title">{{lastDone.statusDesc}}</view>
		<view class="lastdone-code">{{lastDone.STORAGE_CODE}}</view>
		<view class="lastdone-plate">{{lastDone.STORAGE_PLATE}} · {{lastDone.STORAGE_CABINET_NAME}} {{lastDone.STORAGE_CABINET_NO}}</view>
		<view class="empty-desc">{{lastDone.fetchDoneTimeText || lastDone.cancelTimeText || lastDone.addTimeText}}</view>
		<view class="empty-desc">合计费用：¥{{lastDone.feeTotalText}}</view>
	</view>

	<view wx:if="{{!list.length && !lastDone}}" class="empty-card">
		<view class="empty-title">暂无存取柜记录</view>
		<view class="empty-desc">存柜登记后生成存柜码，取柜按天计费。</view>
	</view>

	<view class="footer-actions">
		<view bindtap="bindStoreTap">我要存柜</view>
		<view bindtap="bindFetchTap">我要取柜</view>
		<view bindtap="bindRefreshTap">刷新</view>
	</view>
</view>

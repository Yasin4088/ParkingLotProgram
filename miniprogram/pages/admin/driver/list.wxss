.page {
    min-height: 100vh;
    background: #f5f5f5;
    padding-bottom: 40rpx;
}

/* 司机列表项 */
.driver-item {
    background: #fff;
    margin: 16rpx 20rpx;
    border-radius: 12rpx;
    padding: 24rpx;
    box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.top-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10rpx;
}

.d-name {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.d-status {
    font-size: 22rpx;
    padding: 4rpx 16rpx;
    border-radius: 20rpx;
}

.d-status.on {
    background: #e8f5e9;
    color: #2e7d32;
}

.d-status.off {
    background: #fbe9e7;
    color: #c62828;
}

.mid-row {
    font-size: 24rpx;
    color: #888;
    margin-bottom: 14rpx;
}

.split {
    margin: 0 12rpx;
    color: #ddd;
}

.bottom-row {
    display: flex;
    justify-content: flex-end;
    border-top: 2rpx solid #f5f5f5;
    padding-top: 16rpx;
}

.edit-btn {
    font-size: 26rpx;
    color: #2499f2;
    padding: 8rpx 24rpx;
}

.del-btn {
    font-size: 26rpx;
    color: #e57373;
    padding: 8rpx 24rpx;
}

.load {
    text-align: center;
    font-size: 26rpx;
    padding: 20rpx;
}

/* 底部添加按钮 */
.bottom-btn {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 20rpx 30rpx;
    padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
    background: #f5f5f5;
    z-index: 9999;
    box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.1);
}

.add-driver-btn {
    width: 100%;
    height: 88rpx;
    background: #009F72;
    color: #fff;
    font-size: 32rpx;
    border-radius: 44rpx;
    line-height: 88rpx;
    text-align: center;
}

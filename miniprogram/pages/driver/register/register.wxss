.container {
  padding: 24rpx;
  background: #f1f1f1;
  min-height: 100vh;
}

.reg-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.reg-title {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  color: #333;
}

.reg-subtitle {
  font-size: 28rpx;
  color: #999;
  text-align: center;
  margin-top: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.input-group {
  margin-bottom: 24rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #333;
}

/* 手机号按钮 -- 微信绿色 */
.phone-btn {
  width: 100%;
  height: 88rpx;
  background: #07C160;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 12rpx;
  border: none;
  line-height: 88rpx;
}

.phone-btn:active {
  background: #06ad56;
}

/* 手动输入手机号降级方案 */
.divider-text {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  margin: 24rpx 0;
}

.manual-btn {
  width: 100%;
  height: 72rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 12rpx;
  border: 2rpx solid #e0e0e0;
  line-height: 72rpx;
  margin-top: 16rpx;
}

.manual-btn:active {
  background: #e8e8e8;
}

.phone-got {
  background: #f0faf5;
  border: 2rpx solid #07C160;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
}

.phone-check {
  font-size: 30rpx;
  color: #07C160;
  font-weight: bold;
}

.phone-num {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

/* 上传区域 */
.upload-group {
  margin-bottom: 24rpx;
}

.upload-zone {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-zone:active {
  background: #f0f0f0;
}

.upload-icon {
  font-size: 52rpx;
}

.upload-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

.upload-preview {
  position: relative;
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #eee;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(0,0,0,0.5);
  color: #fff;
  text-align: center;
  padding: 12rpx;
  font-size: 24rpx;
}

/* 提交按钮 -- 与项目主题色一致 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #009F72 0%, #00c48a 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  line-height: 88rpx;
}

.submit-btn:active {
  opacity: 0.9;
}

.footer-text {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 32rpx;
  padding-bottom: 48rpx;
}

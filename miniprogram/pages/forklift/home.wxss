.page {
	min-height: 100vh;
	background: #f5f5f5;
	padding-bottom: 40rpx;
}

.header {
	background: #E67E22;
	color: #fff;
	padding: 40rpx 30rpx 30rpx;
	position: relative;
}

.header .title {
	font-size: 40rpx;
	font-weight: bold;
}

.header .desc {
	font-size: 26rpx;
	opacity: 0.85;
	margin-top: 8rpx;
}

.header .logout {
	position: absolute;
	right: 30rpx;
	top: 44rpx;
	font-size: 28rpx;
	padding: 8rpx 20rpx;
	border: 2rpx solid rgba(255,255,255,0.6);
	border-radius: 20rpx;
}

.task-card {
	background: #fff;
	margin: 30rpx 20rpx;
	border-radius: 16rpx;
	padding: 30rpx 24rpx;
	box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
}

.task-status {
	display: inline-block;
	font-size: 24rpx;
	background: #fff3e0;
	color: #E67E22;
	padding: 6rpx 20rpx;
	border-radius: 20rpx;
	margin-bottom: 20rpx;
}

.task-grid {
	margin-bottom: 24rpx;
}

.task-row {
	display: flex;
	justify-content: space-between;
	padding: 14rpx 0;
	border-bottom: 2rpx solid #f5f5f5;
}

.t-label {
	font-size: 28rpx;
	color: #999;
}

.t-value {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
}

.complete-btn {
	width: 100%;
	height: 88rpx;
	background: linear-gradient(135deg, #E67E22 0%, #f39c12 100%);
	color: #fff;
	font-size: 34rpx;
	font-weight: bold;
	border-radius: 44rpx;
	border: none;
	line-height: 88rpx;
}

.empty-card {
	margin: 60rpx 40rpx;
	text-align: center;
}

.empty-title {
	font-size: 32rpx;
	color: #999;
	margin-bottom: 12rpx;
}

.empty-desc {
	font-size: 26rpx;
	color: #bbb;
}

.refresh {
	text-align: center;
	font-size: 28rpx;
	color: #E67E22;
	padding: 30rpx;
}

<view class="page">
	<view class="custom-nav" style="height: {{customBar}}px; padding-top: {{statusBar}}px;">
		<view class="custom-nav-back" style="top: {{statusBar}}px; height: {{navBarHeight}}px;" bindtap="bindLogoutTap">
			<view class="custom-nav-back-icon"></view>
		</view>
		<view class="custom-nav-title" style="height: {{navBarHeight}}px; line-height: {{navBarHeight}}px;">认领任务</view>
	</view>

	<view class="header">
		<view class="title">认领任务</view>
		<view class="desc">管理员已预先创建任务，输入一致的车牌号即可认领，认领后到场签到排队</view>
	</view>

	<view class="card">
		<view class="form-item">
			<view class="label">车牌号</view>
			<input value="{{plate}}" placeholder="例如：粤B12345（需与任务车牌一致）" maxlength="20" bindinput="bindPlateInput" />
		</view>

		<view class="form-item">
			<view class="label">手机号</view>
			<input value="{{phone}}" placeholder="用于现场联系" type="number" maxlength="11" bindinput="bindPhoneInput" />
		</view>

		<view class="form-item">
			<view class="label">单证照片（可选）</view>
			<view class="upload" bindtap="bindChooseProof">
				<image wx:if="{{proofLocal}}" src="{{proofLocal}}" mode="aspectFill"></image>
				<view wx:else class="upload-empty">拍照/上传单证（选填）</view>
			</view>
		</view>

		<button class="primary-btn" loading="{{submitting}}" bindtap="bindSubmitTap">认领任务</button>
	</view>

	<view class="footer-actions">
		<view bindtap="bindQueueTap">查看我的排队</view>
		<view bindtap="bindProfileTap">个人信息填写</view>
	</view>
</view>

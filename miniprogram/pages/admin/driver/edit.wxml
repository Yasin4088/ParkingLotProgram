<view wx:if="{{isAdmin && isLoad}}" class="page">
    <view class="form-card">

        <!-- ===== 可编辑基础信息 ===== -->
        <view class="section-title">基础信息</view>

        <view class="form-group">
            <view class="label">用户名</view>
            <input placeholder="请输入用户名" placeholder-class="ph" value="{{username}}" bindinput="bindUsernameInput" maxlength="20" />
        </view>

        <view class="form-group">
            <view class="label">密码{{id ? '（留空则不修改）' : ''}}</view>
            <input placeholder="{{id ? '留空则不修改密码' : '请输入密码'}}" placeholder-class="ph" type="text" value="{{password}}" bindinput="bindPasswordInput" maxlength="20" />
        </view>

        <view class="form-group">
            <view class="label">手机号</view>
            <input placeholder="请输入手机号" placeholder-class="ph" type="number" value="{{phone}}" bindinput="bindPhoneInput" maxlength="11" />
        </view>

        <view wx:if="{{id}}" class="form-group">
            <view class="label">账号状态</view>
            <picker mode="selector" range="{{statusItems}}" value="{{statusIndex}}" bindchange="bindStatusChange">
                <view class="picker-val">{{statusDesc}}</view>
            </picker>
        </view>

        <!-- ===== 司机身份信息（只读） ===== -->
        <block wx:if="{{id}}">
            <view class="section-title">身份信息</view>

            <view class="form-group">
                <view class="label">身份证号</view>
                <view class="readonly-val">{{idcard || '未填写'}}</view>
            </view>

            <view class="form-group">
                <view class="label">车牌号</view>
                <view class="readonly-val">{{licensePlate || '未填写'}}</view>
            </view>

            <view class="form-group">
                <view class="label">所在单位</view>
                <view class="readonly-val">{{work || '未填写'}}</view>
            </view>

            <view class="form-group">
                <view class="label">所在城市</view>
                <view class="readonly-val">{{city || '未填写'}}</view>
            </view>

            <view class="form-group">
                <view class="label">职业领域</view>
                <view class="readonly-val">{{trade || '未填写'}}</view>
            </view>

            <!-- 证件图片 -->
            <view class="section-title">证件图片</view>

            <view class="form-group">
                <view class="label">身份证照片</view>
                <image wx:if="{{idcardImg}}" class="proof-img" src="{{idcardImg}}" mode="aspectFill" bindtap="bindPreviewImg" data-url="{{idcardImg}}" />
                <view wx:else class="readonly-val">未上传</view>
            </view>

            <view class="form-group">
                <view class="label">驾驶证照片</view>
                <image wx:if="{{driverLicenseImg}}" class="proof-img" src="{{driverLicenseImg}}" mode="aspectFill" bindtap="bindPreviewImg" data-url="{{driverLicenseImg}}" />
                <view wx:else class="readonly-val">未上传</view>
            </view>

            <view class="form-group">
                <view class="label">行驶证照片</view>
                <image wx:if="{{vehicleRegImg}}" class="proof-img" src="{{vehicleRegImg}}" mode="aspectFill" bindtap="bindPreviewImg" data-url="{{vehicleRegImg}}" />
                <view wx:else class="readonly-val">未上传</view>
            </view>

            <!-- 账号统计 -->
            <view class="section-title">账号统计</view>

            <view class="form-group">
                <view class="label">注册时间</view>
                <view class="readonly-val">{{addTime || '未知'}}</view>
            </view>

            <view class="form-group">
                <view class="label">最近登录</view>
                <view class="readonly-val">{{loginTime || '未登录'}}</view>
            </view>

            <view class="form-group">
                <view class="label">登录次数</view>
                <view class="readonly-val">{{loginCnt}}</view>
            </view>

            <view class="form-group">
                <view class="label">手机已验证</view>
                <view class="readonly-val {{phoneVerified ? 'verified' : 'unverified'}}">{{phoneVerified ? '已验证' : '未验证'}}</view>
            </view>
        </block>

        <view class="submit-btn" bindtap="bindSubmitTap">
            <view wx:if="{{submitting}}">提交中...</view>
            <view wx:else>{{id ? '保存修改' : '确认添加'}}</view>
        </view>
    </view>
</view>
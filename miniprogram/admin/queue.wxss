.page {
	min-height: 100vh;
	background: #f5f7f8;
	padding: 28rpx;
	box-sizing: border-box;
}

.header {
	background: #243b53;
	border-radius: 24rpx;
	color: #fff;
	padding: 36rpx 30rpx;
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 28rpx;
}

.title {
	font-size: 40rpx;
	font-weight: bold;
}

.desc {
	font-size: 26rpx;
	opacity: .86;
	margin-top: 14rpx;
}

.header-actions {
	display: flex;
	flex-direction: column;
	gap: 12rpx;
}

.driver-mgr {
	font-size: 24rpx;
	background: rgba(255, 255, 255, .16);
	padding: 10rpx 20rpx;
	border-radius: 999rpx;
	text-align: center;
}

.logout {
	font-size: 24rpx;
	background: rgba(255, 255, 255, .16);
	padding: 10rpx 20rpx;
	border-radius: 999rpx;
	text-align: center;
}

.toolbar {
	display: flex;
	gap: 20rpx;
	margin-bottom: 24rpx;
}

.picker {
	flex: 1;
	height: 84rpx;
	line-height: 84rpx;
	background: #fff;
	border-radius: 16rpx;
	padding: 0 24rpx;
	color: #243b53;
	font-size: 28rpx;
	box-sizing: border-box;
}

.call-btn {
	width: 190rpx;
	height: 84rpx;
	line-height: 84rpx;
	border-radius: 42rpx;
	background: #f07818;
	color: #fff;
	font-size: 30rpx;
}

.summary {
	font-size: 26rpx;
	color: #7b8794;
	margin-bottom: 18rpx;
}

.queue-card {
	background: #fff;
	border-radius: 20rpx;
	padding: 28rpx;
	margin-bottom: 22rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
	border-left: 8rpx solid #009F72;
}

.queue-card.called {
	border-left-color: #f07818;
}

.top {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.no {
	font-size: 48rpx;
	font-weight: bold;
	color: #102a43;
}

.status {
	font-size: 24rpx;
	color: #009F72;
	background: #e6f7f1;
	padding: 8rpx 20rpx;
	border-radius: 999rpx;
}

.called .status {
	color: #f07818;
	background: #fff1e6;
}

.plate {
	font-size: 36rpx;
	font-weight: bold;
	color: #243b53;
	margin: 18rpx 0 10rpx;
}

.meta {
	font-size: 26rpx;
	color: #627d98;
	line-height: 1.7;
}

.finish-btn {
	margin-top: 22rpx;
	height: 76rpx;
	line-height: 76rpx;
	border-radius: 38rpx;
	background: #009F72;
	color: #fff;
	font-size: 28rpx;
}

.empty {
	background: #fff;
	border-radius: 20rpx;
	padding: 70rpx 30rpx;
	text-align: center;
	color: #8a99a8;
	font-size: 28rpx;
}

.refresh {
	text-align: center;
	color: #009F72;
	font-size: 26rpx;
	padding: 34rpx 0;
}

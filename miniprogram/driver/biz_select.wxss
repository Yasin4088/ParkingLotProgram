.page {
	min-height: 100vh;
	background: #f5f7f8;
	padding: 0 28rpx 28rpx;
	box-sizing: border-box;
}

.custom-nav {
	margin: 0 -28rpx 40rpx;
	background: #3B82E6;
	color: #fff;
	box-sizing: border-box;
	position: relative;
}

.custom-nav-title {
	text-align: center;
	font-size: 32rpx;
	font-weight: 600;
}

.tiles {
	margin-bottom: 20rpx;
}

.tile {
	display: flex;
	align-items: center;
	background: #fff;
	border-radius: 24rpx;
	padding: 44rpx 32rpx;
	margin-bottom: 24rpx;
	box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, .06);
	position: relative;
}

.tile-icon {
	width: 96rpx;
	height: 96rpx;
	border-radius: 24rpx;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 52rpx;
	margin-right: 28rpx;
	background: #f0f6ff;
	flex-shrink: 0;
}

.tile-store .tile-icon {
	background: #fff7e8;
}

.tile-fetch .tile-icon {
	background: #eefaf3;
}

.tile-name {
	flex: 1;
	font-size: 36rpx;
	font-weight: 600;
	color: #333;
	display: flex;
	align-items: center;
}

.tile-badge {
	margin-left: 16rpx;
	font-size: 22rpx;
	color: #fff;
	background: #E67E22;
	border-radius: 20rpx;
	padding: 4rpx 14rpx;
	font-weight: normal;
}

.tile-arrow {
	width: 16rpx;
	height: 16rpx;
	border-top: 4rpx solid #c8ccd0;
	border-right: 4rpx solid #c8ccd0;
	transform: rotate(45deg);
	margin-left: 16rpx;
	flex-shrink: 0;
}

.bottom-links {
	display: flex;
	justify-content: center;
	gap: 48rpx;
	color: #3B82E6;
	font-size: 26rpx;
	padding: 40rpx 0;
}

<view class="page">
	<view class="custom-nav" style="height: {{customBar}}px; padding-top: {{statusBar}}px;">
		<view class="custom-nav-back" style="top: {{statusBar}}px; height: {{navBarHeight}}px;" bindtap="bindLogoutTap">
			<view class="custom-nav-back-icon"></view>
		</view>
		<view class="custom-nav-title" style="height: {{navBarHeight}}px; line-height: {{navBarHeight}}px;">我的排队</view>
	</view>

	<view class="header">
		<view class="title">我的排队</view>
		<view class="desc">到达堆场后请先完成 GPS 签到，再等待管理员叫号</view>
	</view>

	<view wx:if="{{item}}" class="card">
		<view class="status {{item.QUEUE_STATUS === 2 ? 'called' : ''}} {{item.QUEUE_STATUS === 3 ? 'confirmed' : ''}}">{{item.statusDesc}}</view>
		<view class="queue-no">{{item.QUEUE_NO || '--'}}</view>
		<view class="queue-label">排队号</view>

		<view class="info-grid">
			<view>
				<view class="info-label">业务</view>
				<view class="info-val">{{item.QUEUE_ACTION_NAME}}</view>
			</view>
			<view>
				<view class="info-label">车牌</view>
				<view class="info-val">{{item.QUEUE_PLATE}}</view>
			</view>
			<view wx:if="{{item.QUEUE_CARGO_NAME}}">
				<view class="info-label">货物名称</view>
				<view class="info-val">{{item.QUEUE_CARGO_NAME}}</view>
			</view>
			<view>
				<view class="info-label">前方人数</view>
				<view class="info-val strong">{{item.ahead || 0}}</view>
			</view>
		</view>

		<!-- 叫号后显示叉车司机信息 + 确认按钮 -->
		<view wx:if="{{item.QUEUE_STATUS === 2 && item.QUEUE_FORKLIFT_NAME}}" class="forklift-info">
			<view class="fl-label">分配的叉车司机</view>
			<view class="fl-name">{{item.QUEUE_FORKLIFT_NAME}}</view>
			<view class="fl-tip">请点击下方按钮确认收到叫号通知</view>
		</view>

		<!-- 已确认状态 -->
		<view wx:if="{{item.QUEUE_STATUS === 3}}" class="forklift-info confirmed">
			<view class="fl-label">叉车司机 {{item.QUEUE_FORKLIFT_NAME}} 已收到通知</view>
			<view class="fl-tip">装卸完成后，请上传完成作业凭证并提交</view>
		</view>

		<view wx:if="{{item.QUEUE_STATUS === 3}}" class="finish-proof">
			<view class="finish-title">完成作业凭证</view>
			<view class="finish-desc">请拍照上传现场签收单、装卸完成照片等凭证</view>
			<view class="upload" bindtap="bindChooseFinishProof">
				<image wx:if="{{finishProofLocal}}" src="{{finishProofLocal}}" mode="aspectFill"></image>
				<view wx:else class="upload-empty">{{uploadingFinishProof ? '上传中...' : '拍照/上传凭证'}}</view>
			</view>
		</view>

		<view wx:if="{{item.QUEUE_STATUS === 0}}" class="tips">已预约，抵达现场后点击 GPS 签到进入队列。</view>
		<view wx:elif="{{item.QUEUE_STATUS === 1}}" class="tips">排队中，请关注叫号通知。</view>
		<view wx:elif="{{item.QUEUE_STATUS === 2 && !item.QUEUE_FORKLIFT_NAME}}" class="tips called-text">已叫号，请前往装卸区。</view>
		<view wx:elif="{{item.QUEUE_STATUS === 2 && item.QUEUE_FORKLIFT_NAME}}" class="tips called-text">已叫号，请确认收到通知。</view>

		<button wx:if="{{item.QUEUE_STATUS === 0}}" loading="{{loading}}" class="primary-btn" bindtap="bindCheckinTap">GPS 签到</button>
		<button wx:if="{{item.QUEUE_STATUS === 2 && item.QUEUE_FORKLIFT_NAME}}" class="confirm-btn" bindtap="bindConfirmTap">确认收到</button>
		<button wx:if="{{item.QUEUE_STATUS === 3}}" loading="{{finishing || uploadingFinishProof}}" class="finish-btn" bindtap="bindFinishTap">完成作业</button>
		<button wx:if="{{item.QUEUE_STATUS === 0 || item.QUEUE_STATUS === 1}}" class="ghost-btn" bindtap="bindSubscribeTap">{{item.QUEUE_SUBSCRIBE ? '已订阅叫号通知' : '订阅叫号通知'}}</button>
	</view>

	<view wx:else class="empty-card">
		<view class="empty-title">暂无预约</view>
		<view class="empty-desc">请先提交装卸预约，再查看排队信息。</view>
	</view>

	<view class="footer-actions">
		<view bindtap="bindHomeTap">去预约</view>
		<view bindtap="bindRefreshTap">刷新</view>
	</view>
</view>

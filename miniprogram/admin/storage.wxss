.page {
	min-height: 100vh;
	background: #f5f7f8;
	padding: 28rpx 28rpx 160rpx;
	box-sizing: border-box;
}

/* 顶部操作条 */
.top-bar {
	display: flex;
	margin-bottom: 20rpx;
}

.top-btn {
	flex: 1;
	height: 88rpx;
	line-height: 88rpx;
	background: #3B82E6;
	color: #fff;
	border-radius: 44rpx;
	text-align: center;
	font-size: 30rpx;
	font-weight: bold;
	box-shadow: 0 6rpx 16rpx rgba(59, 130, 230, .25);
}

.summary {
	font-size: 26rpx;
	color: #7b8794;
	margin-bottom: 18rpx;
}

/* 自动叫号开关 */
.auto-call-bar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	background: #fff;
	border-radius: 20rpx;
	padding: 22rpx 28rpx;
	margin-bottom: 20rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
}

.auto-call-info {
	flex: 1;
	margin-right: 24rpx;
}

.auto-call-title {
	font-size: 28rpx;
	font-weight: bold;
	color: #102a43;
}

.auto-call-desc {
	font-size: 22rpx;
	color: #7b8794;
	margin-top: 6rpx;
	line-height: 1.5;
}

/* 状态统计筛选条 */
.chip-bar {
	display: flex;
	flex-wrap: wrap;
	gap: 14rpx;
	margin-bottom: 18rpx;
}

.chip {
	font-size: 24rpx;
	color: #627d98;
	background: #fff;
	padding: 10rpx 22rpx;
	border-radius: 999rpx;
	border: 1rpx solid #d9e2ec;
}

.chip.active {
	color: #fff;
	background: #3B82E6;
	border-color: #3B82E6;
	font-weight: bold;
}

/* 当前环节用时 */
.elapsed {
	font-size: 24rpx;
	color: #9fb3c8;
	margin-top: 8rpx;
}

.queue-card {
	background: #fff;
	border-radius: 20rpx;
	padding: 28rpx;
	margin-bottom: 22rpx;
	box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, .05);
	border-left: 8rpx solid #3B82E6;
}

.queue-card:active {
	opacity: .82;
}

/* 状态配色（卡片左边条 + 徽标） */
.queue-card.st-pending {
	border-left-color: #7b8794;
}

.queue-card.st-booked {
	border-left-color: #627d98;
}

.queue-card.st-waiting {
	border-left-color: #3B82E6;
}

.queue-card.st-called {
	border-left-color: #f07818;
}

.queue-card.st-executing {
	border-left-color: #2196F3;
}

.queue-card.st-settling {
	border-left-color: #7c3aed;
}

.queue-card.st-topay {
	border-left-color: #e53e3e;
}

.top {
	display: flex;
	justify-content: space-between;
	align-items: center;
}

.no {
	font-size: 48rpx;
	font-weight: bold;
	color: #000;
}

.status {
	font-size: 24rpx;
	color: #000;
	background: #eef0ff;
	padding: 8rpx 20rpx;
	border-radius: 999rpx;
}

.mplate-tag {
	display: inline-block;
	margin-left: 12rpx;
	padding: 4rpx 14rpx;
	border-radius: 999rpx;
	background: #e6f7f0;
	color: #0E9F6E;
	font-size: 22rpx;
}

.company-tag {
	display: inline-block;
	margin-left: 10rpx;
	padding: 4rpx 14rpx;
	border-radius: 999rpx;
	background: #e6f7f0;
	color: #0E9F6E;
	font-size: 22rpx;
}

.company-tag.other {
	background: #fff1e6;
	color: #e67e22;
}

.status.st-pending {
	color: #627d98;
	background: #f0f4f8;
}

.status.st-booked {
	color: #486581;
	background: #eef2f6;
}

.status.st-waiting {
	color: #1565C0;
	background: #e3f2fd;
}

.status.st-called {
	color: #f07818;
	background: #fff1e6;
}

.status.st-executing {
	color: #1565C0;
	background: #e3f2fd;
}

.status.st-settling {
	color: #7c3aed;
	background: #f3e8ff;
}

.status.st-topay {
	color: #c62828;
	background: #ffebee;
}

.plate {
	font-size: 36rpx;
	font-weight: bold;
	color: #000;
	margin: 18rpx 0 10rpx;
}

.meta {
	font-size: 26rpx;
	color: #627d98;
	line-height: 1.7;
}

/* 卡片内操作按钮 */
.card-actions {
	margin-top: 20rpx;
	display: flex;
	gap: 16rpx;
}

.card-btn {
	flex: 1;
	height: 68rpx;
	line-height: 68rpx;
	border-radius: 34rpx;
	text-align: center;
	font-size: 26rpx;
	box-sizing: border-box;
}

.card-btn.orange {
	background: #fff1e6;
	color: #f07818;
	border: 1rpx solid #f07818;
}

.card-btn.ghost {
	background: #f0f4f8;
	color: #627d98;
	border: 1rpx solid #d9e2ec;
}

/* 状态提示条 */
.wait-confirm {
	margin-top: 16rpx;
	font-size: 26rpx;
	color: #f07818;
	background: #fff1e6;
	padding: 12rpx 20rpx;
	border-radius: 12rpx;
	text-align: center;
}

.wait-confirm.blue {
	color: #1565C0;
	background: #e3f2fd;
}

.wait-confirm.red {
	color: #c62828;
	background: #ffebee;
}

.wait-confirm.gray {
	color: #627d98;
	background: #f0f4f8;
}

.call-btn {
	margin-top: 22rpx;
	height: 76rpx;
	line-height: 76rpx;
	border-radius: 38rpx;
	background: #f07818;
	color: #fff;
	font-size: 28rpx;
}

.finish-btn {
	margin-top: 22rpx;
	height: 76rpx;
	line-height: 76rpx;
	border-radius: 38rpx;
	background: #3B82E6;
	color: #fff;
	font-size: 28rpx;
}

.empty {
	background: #fff;
	border-radius: 20rpx;
	padding: 70rpx 30rpx;
	text-align: center;
	color: #8a99a8;
	font-size: 28rpx;
}

.refresh {
	text-align: center;
	color: #000;
	font-size: 26rpx;
	padding: 34rpx 0;
}

.bottom-links {
	display: flex;
	justify-content: center;
	gap: 48rpx;
	color: #3B82E6;
	font-size: 26rpx;
	padding: 34rpx 0;
}

/* ========== 弹窗通用 ========== */

.call-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(15, 23, 42, .46);
	z-index: 100;
	display: flex;
	align-items: center;
	justify-content: center;
}

.call-panel {
	width: 620rpx;
	max-height: 80vh;
	overflow-y: auto;
	background: #fff;
	border-radius: 24rpx;
	padding: 40rpx 34rpx 34rpx;
	box-sizing: border-box;
}

.call-panel.small {
	padding: 34rpx 30rpx 28rpx;
}

.call-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 24rpx;
}

.call-title {
	font-size: 34rpx;
	font-weight: bold;
	color: #102a43;
}

.call-close {
	font-size: 28rpx;
	color: #999;
	padding: 8rpx;
}

.call-info {
	background: #f7fafc;
	border-radius: 14rpx;
	padding: 16rpx 20rpx;
	margin-bottom: 24rpx;
}

.call-row {
	display: flex;
	justify-content: space-between;
	padding: 12rpx 0;
	border-bottom: 1rpx solid #e8edf2;
	font-size: 28rpx;
}

.call-row:last-child {
	border-bottom: none;
}

.call-label {
	color: #7b8794;
}

.call-value {
	color: #243b53;
	font-weight: 500;
}

.call-tip {
	font-size: 25rpx;
	color: #627d98;
	background: #f7fafc;
	border-radius: 12rpx;
	padding: 16rpx 20rpx;
	margin-bottom: 26rpx;
	line-height: 1.6;
}

.call-forklift {
	margin-bottom: 30rpx;
}

.call-forklift .call-label {
	font-size: 28rpx;
	color: #333;
	font-weight: bold;
	margin-bottom: 14rpx;
	display: block;
}

.forklift-picker {
	width: 100%;
	height: 84rpx;
	line-height: 84rpx;
	background: #f7fafc;
	border: 2rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 0 22rpx;
	font-size: 30rpx;
	color: #E67E22;
	font-weight: bold;
	box-sizing: border-box;
	text-align: center;
}

.call-confirm-btn {
	width: 100%;
	height: 84rpx;
	line-height: 84rpx;
	border-radius: 42rpx;
	background: #f07818;
	color: #fff;
	font-size: 32rpx;
}

/* ========== 表单（弹窗内） ========== */

.form-group {
	margin-bottom: 22rpx;
}

.form-label {
	font-size: 25rpx;
	color: #627d98;
	margin-bottom: 12rpx;
}

.edit-input {
	height: 78rpx;
	line-height: 78rpx;
	background: #fff;
	border: 1rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 0 20rpx;
	box-sizing: border-box;
	font-size: 28rpx;
	color: #000;
}

/* ========== 柜型管理 ========== */

.cabinet-empty {
	padding: 40rpx 0;
	text-align: center;
	color: #8a99a8;
	font-size: 26rpx;
}

.cabinet-item {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 20rpx;
	background: #f7fafc;
	border-radius: 16rpx;
	padding: 22rpx;
	margin-bottom: 16rpx;
}

.cabinet-info {
	flex: 1;
	min-width: 0;
}

.cabinet-name {
	font-size: 30rpx;
	color: #102a43;
	font-weight: 600;
	display: flex;
	align-items: center;
	gap: 12rpx;
}

.cabinet-status {
	font-size: 20rpx;
	color: #1565C0;
	background: #e3f2fd;
	padding: 2rpx 12rpx;
	border-radius: 999rpx;
}

.cabinet-status.forbid {
	color: #627d98;
	background: #f0f4f8;
}

.cabinet-price {
	font-size: 24rpx;
	color: #627d98;
	margin-top: 8rpx;
}

.cabinet-actions {
	display: flex;
	gap: 12rpx;
	flex-shrink: 0;
}

.cabinet-actions .card-btn {
	flex: none;
	padding: 0 24rpx;
}

/* ========== 详情弹窗 ========== */

.detail-mask {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background: rgba(15, 23, 42, .46);
	z-index: 99;
	display: flex;
	align-items: flex-end;
}

.detail-panel {
	width: 100%;
	max-height: 86vh;
	overflow-y: auto;
	background: #fff;
	border-radius: 30rpx 30rpx 0 0;
	padding: 34rpx 30rpx 44rpx;
	box-sizing: border-box;
}

.detail-head {
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin-bottom: 26rpx;
}

.detail-title {
	font-size: 36rpx;
	font-weight: bold;
	color: #000;
}

.detail-sub {
	margin-top: 8rpx;
	font-size: 24rpx;
	color: #7b8794;
}

.detail-close {
	font-size: 26rpx;
	color: #000;
	padding: 8rpx 0 8rpx 24rpx;
}

.detail-grid {
	background: #f7fafc;
	border-radius: 18rpx;
	padding: 10rpx 22rpx;
}

.detail-row {
	display: flex;
	justify-content: space-between;
	gap: 24rpx;
	padding: 20rpx 0;
	border-bottom: 1rpx solid #e8edf2;
	font-size: 26rpx;
}

.detail-row:last-child {
	border-bottom: none;
}

.detail-label {
	color: #7b8794;
	flex-shrink: 0;
}

.detail-value {
	color: #000;
	text-align: right;
	word-break: break-all;
}

.detail-link {
	color: #000;
}

.detail-actions {
	display: flex;
	margin-top: 26rpx;
}

.detail-actions.two {
	gap: 18rpx;
}

.detail-btn {
	flex: 1;
	height: 78rpx;
	line-height: 78rpx;
	border-radius: 39rpx;
	text-align: center;
	font-size: 28rpx;
}

.detail-btn.primary {
	background: #3B82E6;
	color: #fff;
}

.detail-btn.warn {
	background: #f07818;
	color: #fff;
}

.detail-btn.ghost {
	background: #f0f4f8;
	color: #000;
}

/* 费用明细 */
.fee-box {
	margin-top: 24rpx;
	background: #f7fafc;
	border-radius: 18rpx;
	padding: 20rpx 22rpx;
}

.fee-box-title {
	font-size: 26rpx;
	color: #627d98;
	margin-bottom: 8rpx;
}

.fee-line {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 12rpx 0;
	border-bottom: 1rpx solid #e8edf2;
}

.fee-line:last-child {
	border-bottom: none;
}

.fee-line-name {
	font-size: 27rpx;
	color: #000;
}

.fee-line-amount {
	font-size: 27rpx;
	color: #000;
	font-weight: 500;
}

.fee-total {
	margin-top: 14rpx;
	text-align: right;
	font-size: 30rpx;
	font-weight: bold;
	color: #e53e3e;
}

.cancel-box {
	margin-top: 30rpx;
	padding-top: 26rpx;
	border-top: 1rpx solid #e8edf2;
}

.reason-input {
	width: 100%;
	height: 150rpx;
	background: #f7fafc;
	border: 1rpx solid #d9e2ec;
	border-radius: 14rpx;
	padding: 18rpx 20rpx;
	box-sizing: border-box;
	font-size: 26rpx;
	color: #000;
}

.danger-btn {
	margin-top: 20rpx;
	height: 78rpx;
	line-height: 78rpx;
	border-radius: 39rpx;
	background: #e53e3e;
	color: #fff;
	font-size: 28rpx;
	text-align: center;
}

/* ========== 底部工作区切换（装卸货 / 存取柜 / 后台） ========== */

.bottom-nav {
	position: fixed;
	left: 0;
	right: 0;
	bottom: 0;
	display: flex;
	background: #fff;
	box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, .08);
	padding-bottom: env(safe-area-inset-bottom);
	z-index: 90;
}

.bottom-nav-item {
	flex: 1;
	height: 100rpx;
	line-height: 100rpx;
	text-align: center;
	font-size: 30rpx;
	color: #627d98;
}

.bottom-nav-item.active {
	color: #3B82E6;
	font-weight: bold;
}

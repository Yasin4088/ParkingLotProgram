<view class="main">
    <view class="login-card shadow">
        <view class="logo">
            <view class="icon-park">P</view>
            <view class="title">停车场装卸</view>
        </view>

        <!-- 标签切换 -->
        <view class="tabs">
            <view class="tab {{tab === 'driver' ? 'active' : ''}}" bindtap="bindTabTap" data-tab="driver">司机登录</view>
            <view class="tab {{tab === 'admin' ? 'active' : ''}}" bindtap="bindTabTap" data-tab="admin">管理员登录</view>
        </view>

        <!-- 司机端：微信一键登录 -->
        <block wx:if="{{tab === 'driver'}}">
            <button class="login-btn wechat-btn" loading="{{loading}}" bindtap="bindWxLoginTap">
                微信一键登录
            </button>
            <view class="hint">首次登录后需完善个人信息</view>
        </block>

        <!-- 管理员端：系统初始化 -->
        <block wx:elif="{{needSetup}}">
            <view class="setup-tip">
                <text>首次使用，请创建超级管理员</text>
            </view>
            <view class="form">
                <view class="form-item">
                    <input placeholder="请输入管理员名" value="{{name}}" bindinput="bindNameInput" maxlength="30" />
                </view>
                <view class="form-item">
                    <input placeholder="请输入密码" type="password" value="{{pwd}}" bindinput="bindPwdInput" maxlength="30" />
                </view>
                <view class="form-item">
                    <input placeholder="请确认密码" type="password" value="{{confirmPwd}}" bindinput="bindConfirmPwdInput" maxlength="30" />
                </view>

                <button class="login-btn setup-btn" loading="{{loading}}" bindtap="bindSetupTap">初始化系统</button>
            </view>
        </block>

        <!-- 管理员端：用户名密码登录 -->
        <block wx:else>
            <view class="form">
                <view class="form-item">
                    <input placeholder="请输入用户名" value="{{name}}" bindinput="bindNameInput" maxlength="30" />
                </view>
                <view class="form-item">
                    <input placeholder="请输入密码" type="password" value="{{pwd}}" bindinput="bindPwdInput" maxlength="30" />
                </view>

                <button class="login-btn" loading="{{loading}}" bindtap="bindLoginTap">登 录</button>
            </view>
        </block>

    </view>
</view>
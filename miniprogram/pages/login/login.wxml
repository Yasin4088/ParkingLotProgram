<view class="main">
    <view class="login-card shadow">
        <view class="logo">
            <view class="icon-park">P</view>
            <view class="title">停车场装卸排队</view>
        </view>

        <!-- 标签切换 -->
        <view class="tabs">
            <view class="tab {{tab === 'driver' ? 'active' : ''}}" bindtap="bindTabTap" data-tab="driver">司机登录</view>
            <view class="tab {{tab === 'admin' ? 'active' : ''}}" bindtap="bindTabTap" data-tab="admin">管理员登录</view>
        </view>

        <!-- 表单 -->
        <view class="form">
            <view class="form-item">
                <input placeholder="请输入用户名" value="{{name}}" bindinput="bindNameInput" maxlength="30" />
            </view>
            <view class="form-item">
                <input placeholder="请输入密码" type="password" value="{{pwd}}" bindinput="bindPwdInput" maxlength="30" />
            </view>

            <button class="login-btn" loading="{{loading}}" bindtap="bindLoginTap">登 录</button>
        </view>

        <view class="hint">{{tab === 'admin' ? '默认管理员：Yasin / 4088' : '司机账号由管理员在后台分配，请使用分配的账号登录'}}</view>
    </view>
</view>

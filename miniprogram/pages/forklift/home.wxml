<view wx:if="{{isLoad}}" class="page">
	<view class="custom-nav" style="height: {{customBar}}px; padding-top: {{statusBar}}px;">
		<view class="custom-nav-back" style="top: {{statusBar}}px; height: {{navBarHeight}}px;" bindtap="bindLogoutTap">
			<view class="custom-nav-back-icon"></view>
		</view>
		<view class="custom-nav-title" style="height: {{navBarHeight}}px; line-height: {{navBarHeight}}px;">叉车司机</view>
	</view>

	<view class="header">
		<view class="desc">任务池抢单 · 完成作业</view>
	</view>

	<!-- 我的任务 -->
	<view wx:if="{{myTask}}" class="task-card">
		<view class="task-status">{{myTask.statusDesc}}</view>

		<!-- CALLED：已接单，等待司机确认 -->
		<view wx:if="{{myTask.status === 3}}" class="call-status accepted-status">
			<view class="cs-label">✅ 已接单</view>
			<view class="cs-sub">等待司机确认叫号，确认后进入执行中...</view>
		</view>

		<view class="task-grid">
			<view class="task-row">
				<view class="t-label">车牌号</view>
				<view class="t-value">{{myTask.plate}}</view>
			</view>
			<view wx:if="{{myTask.cargoName}}" class="task-row">
				<view class="t-label">货物名称</view>
				<view class="t-value">{{myTask.cargoName}}</view>
			</view>
			<view wx:if="{{myTask.remark}}" class="task-row">
				<view class="t-label">备注</view>
				<view class="t-value remark">{{myTask.remark}}</view>
			</view>
			<view class="task-row">
				<view class="t-label">业务类型</view>
				<view class="t-value">{{myTask.actionName}}</view>
			</view>
			<view class="task-row">
				<view class="t-label">手机号</view>
				<view class="t-value">{{myTask.phone}}</view>
			</view>
			<view class="task-row">
				<view class="t-label">排队号</view>
				<view class="t-value">{{myTask.queueNo || '--'}}</view>
			</view>
			<view class="task-row">
				<view class="t-label">叫号时间</view>
				<view class="t-value">{{myTask.callTimeText || '--'}}</view>
			</view>
			<view wx:if="{{myTask.status === 3}}" class="task-row">
				<view class="t-label">司机确认</view>
				<view class="t-value">{{myTask.driverConfirmed ? '已确认' : '未确认'}}</view>
			</view>
			<view wx:if="{{myTask.status === 4}}" class="task-row">
				<view class="t-label">开始时间</view>
				<view class="t-value">{{myTask.confirmTimeText || '--'}}</view>
			</view>
		</view>

		<!-- 执行中 → 双凭证上传 + 完成 -->
		<block wx:if="{{myTask.status === 4}}">
			<view class="finish-proof">
				<view class="finish-title">现场照片（必传）</view>
				<view class="finish-desc">拍照上传装卸现场照片</view>
				<view class="upload" bindtap="bindChooseFinishProof">
					<image wx:if="{{finishProofLocal}}" src="{{finishProofLocal}}" mode="aspectFill"></image>
					<view wx:else class="upload-empty">{{uploading ? '上传中...' : '拍照/上传'}}</view>
				</view>
			</view>

			<view class="finish-proof">
				<view class="finish-title">单据照片（必传）</view>
				<view class="finish-desc">拍照上传签收单、单据照片</view>
				<view class="upload" bindtap="bindChooseBillProof">
					<image wx:if="{{billProofLocal}}" src="{{billProofLocal}}" mode="aspectFill"></image>
					<view wx:else class="upload-empty">{{uploading ? '上传中...' : '拍照/上传'}}</view>
				</view>
			</view>

			<button class="complete-btn" loading="{{loading || uploading}}" bindtap="bindCompleteTap">提交完成</button>
		</block>
	</view>

	<!-- 任务池 -->
	<view wx:if="{{pool.length}}" class="pool-section">
		<view class="pool-title">任务池（{{pool.length}}）</view>
		<view wx:for="{{pool}}" wx:key="_id" class="pool-card">
			<view class="pool-top">
				<view class="pool-plate">{{item.plate}}</view>
				<view class="pool-time">{{item.callTimeText}}</view>
			</view>
			<view class="pool-meta">{{item.actionName}}<text wx:if="{{item.cargoName}}"> · {{item.cargoName}}</text><text wx:if="{{item.queueNo}}"> · {{item.queueNo}}号</text></view>
			<button class="grab-btn" data-id="{{item._id}}" loading="{{grabbingId === item._id}}" bindtap="bindGrabTap">抢单</button>
		</view>
	</view>

	<!-- 无任务且任务池为空 -->
	<view wx:if="{{!myTask && !pool.length}}" class="empty-card">
		<view class="empty-title">暂无任务</view>
		<view class="empty-desc">管理员叫号后，任务会出现在抢单池中</view>
	</view>

	<view class="refresh" bindtap="bindRefreshTap">刷新列表</view>
</view>
